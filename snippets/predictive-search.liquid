{%- doc -%}
  Search form wired to Shopify's native predictive search endpoint.

  Degrades to a normal search form submission when JavaScript is off:
  the <form> action and method stay standard.

  @param {string} section_id - Owning section id, for unique ids
{%- enddoc -%}

<form
  action="{{ routes.search_url }}"
  method="get"
  role="search"
  class="search-form"
  data-predictive-search-form
>
  <input type="hidden" name="options[prefix]" value="last">

  <label class="visually-hidden" for="SearchInput-{{ section_id }}">
    {{ 'general.search.placeholder' | t }}
  </label>

  <div class="search-form__field">
    {%- render 'icon-search' -%}
    <input
      type="search"
      id="SearchInput-{{ section_id }}"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'general.search.placeholder' | t }}"
      autocomplete="off"
      autocorrect="off"
      spellcheck="false"
      data-predictive-search-input
      role="combobox"
      aria-expanded="false"
      aria-owns="SearchResults-{{ section_id }}"
      aria-controls="SearchResults-{{ section_id }}"
      aria-autocomplete="list"
    >
    <button type="submit" class="search-form__submit">
      <span class="visually-hidden">{{ 'general.search.submit' | t }}</span>
      {%- render 'icon-arrow-right' -%}
    </button>
  </div>

  <div
    class="predictive-search"
    id="SearchResults-{{ section_id }}"
    data-predictive-search-results
    role="listbox"
    tabindex="-1"
    hidden
  ></div>
</form>
