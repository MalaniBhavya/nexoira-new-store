{%- comment -%}
  Accessible, crawlable pagination for a {% paginate %} block. Works with
  JS disabled - this is the SEO/crawlable fallback that main-collection.liquid's
  infinite scroll enhances on top of, per PRD §6.

  Accepts: paginate (required)
{%- endcomment -%}

{%- if paginate.pages > 1 -%}
  <nav
    class="pagination"
    aria-label="{{ 'general.accessibility.pagination' | t }}"
    data-pagination
    data-next-url="{{ paginate.next.url }}"
  >
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="pagination__link pagination__link--prev">
        {%- render 'icon', name: 'chevron-left', size: 16 -%}
        <span class="visually-hidden">{{ 'general.accessibility.previous' | t }}</span>
      </a>
    {%- endif -%}

    <ul class="pagination__list">
      {%- for part in paginate.parts -%}
        <li>
          {%- if part.is_link -%}
            <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
          {%- elsif part.title == paginate.current_page -%}
            <span class="pagination__link pagination__link--current" aria-current="page">{{ part.title }}</span>
          {%- else -%}
            <span class="pagination__ellipsis">{{ part.title }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="pagination__link pagination__link--next" data-pagination-next>
        <span class="visually-hidden">{{ 'general.accessibility.next' | t }}</span>
        {%- render 'icon', name: 'chevron-right', size: 16 -%}
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
