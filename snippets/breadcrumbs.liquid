{%- doc -%}
  Visible breadcrumb trail. Mirrors the BreadcrumbList JSON-LD in
  snippets/structured-data.liquid. Renders nothing on the homepage.
{%- enddoc -%}

{%- unless request.page_type == 'index' -%}
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <ol class="breadcrumbs__list">
      <li class="breadcrumbs__item">
        <a href="{{ routes.root_url }}">Home</a>
      </li>

      {%- case request.page_type -%}
        {%- when 'product' -%}
          {%- if collection -%}
            <li class="breadcrumbs__item">
              <a href="{{ collection.url }}">{{ collection.title }}</a>
            </li>
          {%- endif -%}
          <li class="breadcrumbs__item" aria-current="page">{{ product.title }}</li>

        {%- when 'collection' -%}
          {%- if collection.handle != blank -%}
            <li class="breadcrumbs__item" aria-current="page">{{ collection.title }}</li>
          {%- endif -%}

        {%- when 'page' -%}
          <li class="breadcrumbs__item" aria-current="page">{{ page.title }}</li>

        {%- when 'article' -%}
          <li class="breadcrumbs__item"><a href="{{ blog.url }}">{{ blog.title }}</a></li>
          <li class="breadcrumbs__item" aria-current="page">{{ article.title }}</li>

        {%- when 'search' -%}
          <li class="breadcrumbs__item" aria-current="page">Search</li>

        {%- when 'cart' -%}
          <li class="breadcrumbs__item" aria-current="page">Cart</li>

        {%- else -%}
          <li class="breadcrumbs__item" aria-current="page">{{ page_title }}</li>
      {%- endcase -%}
    </ol>
  </nav>
{%- endunless -%}
