{%- doc -%}
  Floating WhatsApp support button. Number, message and visibility all
  come from theme settings — nothing here is hard-coded.
{%- enddoc -%}

{%- liquid
  assign wa_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
-%}

{%- if settings.whatsapp_enabled and wa_number != blank -%}
  <a
    class="whatsapp-button"
    href="https://wa.me/{{ wa_number }}{% if settings.whatsapp_message != blank %}?text={{ settings.whatsapp_message | url_encode }}{% endif %}"
    target="_blank"
    rel="noopener"
    aria-label="Chat with us on WhatsApp"
  >
    {%- render 'icon-whatsapp' -%}
    <span class="whatsapp-button__label">Need help?</span>
  </a>
{%- endif -%}
