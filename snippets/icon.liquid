{%- comment -%}
  Renders one inline SVG icon from the theme's shared icon set.

  Accepts:
    name    (required) - one of the icon names listed below
    size    (optional) - width/height in px, default 24
    class   (optional) - extra class(es) added to the <svg>
    title   (optional) - visible-to-screen-readers label; when omitted the
                          icon is aria-hidden (use this for icon-only
                          buttons where the accessible label lives on the
                          parent, e.g. via aria-label or a visually-hidden span)
    id      (optional) - required and must be unique per instance for
                          "star-half" specifically (it defines a <clipPath>)

  Usage:
    {%- render 'icon', name: 'cart', size: 20 -%}
    {%- render 'icon', name: 'star-half', id: 'rating-star-2-4' -%}
{%- endcomment -%}

{%- liquid
  assign icon_size = size | default: 24
  assign icon_id = id | default: 'icon'
-%}
<svg
  class="icon icon-{{ name }}{% if class %} {{ class }}{% endif %}"
  width="{{ icon_size }}"
  height="{{ icon_size }}"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  {% if title %}role="img" aria-label="{{ title }}"{% else %}aria-hidden="true" focusable="false"{% endif %}
>
  {%- case name -%}

    {%- when 'menu' -%}
      <line x1="3" y1="6" x2="21" y2="6"/>
      <line x1="3" y1="12" x2="21" y2="12"/>
      <line x1="3" y1="18" x2="21" y2="18"/>

    {%- when 'close' -%}
      <line x1="6" y1="6" x2="18" y2="18"/>
      <line x1="18" y1="6" x2="6" y2="18"/>

    {%- when 'search' -%}
      <circle cx="10.5" cy="10.5" r="6.5"/>
      <line x1="20" y1="20" x2="15.5" y2="15.5"/>

    {%- when 'cart' -%}
      <path d="M6 8h12l-1 12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2L6 8Z"/>
      <path d="M9 8V6a3 3 0 0 1 6 0v2"/>

    {%- when 'account' -%}
      <circle cx="12" cy="8" r="3.5"/>
      <path d="M4.5 20c1.5-4 4.5-6 7.5-6s6 2 7.5 6"/>

    {%- when 'wishlist' -%}
      <path d="M12 20.5s-7.5-4.6-9.8-9A5.4 5.4 0 0 1 12 6a5.4 5.4 0 0 1 9.8 5.5c-2.3 4.4-9.8 9-9.8 9Z"/>

    {%- when 'wishlist-filled' -%}
      <path fill="currentColor" stroke="none" d="M12 20.5s-7.5-4.6-9.8-9A5.4 5.4 0 0 1 12 6a5.4 5.4 0 0 1 9.8 5.5c-2.3 4.4-9.8 9-9.8 9Z"/>

    {%- when 'chevron-down' -%}
      <polyline points="6 9 12 15 18 9"/>

    {%- when 'chevron-up' -%}
      <polyline points="6 15 12 9 18 15"/>

    {%- when 'chevron-left' -%}
      <polyline points="15 6 9 12 15 18"/>

    {%- when 'chevron-right' -%}
      <polyline points="9 6 15 12 9 18"/>

    {%- when 'arrow-right' -%}
      <line x1="4" y1="12" x2="20" y2="12"/>
      <polyline points="14 6 20 12 14 18"/>

    {%- when 'check' -%}
      <polyline points="5 13 10 18 19 7"/>

    {%- when 'plus' -%}
      <line x1="12" y1="5" x2="12" y2="19"/>
      <line x1="5" y1="12" x2="19" y2="12"/>

    {%- when 'minus' -%}
      <line x1="5" y1="12" x2="19" y2="12"/>

    {%- when 'star' -%}
      <polygon points="12 3.5 14.6 9.2 20.8 9.9 16.2 14.1 17.5 20.3 12 17.1 6.5 20.3 7.8 14.1 3.2 9.9 9.4 9.2"/>

    {%- when 'star-filled' -%}
      <polygon fill="currentColor" stroke="none" points="12 3.5 14.6 9.2 20.8 9.9 16.2 14.1 17.5 20.3 12 17.1 6.5 20.3 7.8 14.1 3.2 9.9 9.4 9.2"/>

    {%- when 'star-half' -%}
      <defs>
        <clipPath id="half-{{ icon_id }}">
          <rect x="0" y="0" width="12" height="24"/>
        </clipPath>
      </defs>
      <polygon points="12 3.5 14.6 9.2 20.8 9.9 16.2 14.1 17.5 20.3 12 17.1 6.5 20.3 7.8 14.1 3.2 9.9 9.4 9.2"/>
      <polygon fill="currentColor" stroke="none" clip-path="url(#half-{{ icon_id }})" points="12 3.5 14.6 9.2 20.8 9.9 16.2 14.1 17.5 20.3 12 17.1 6.5 20.3 7.8 14.1 3.2 9.9 9.4 9.2"/>

    {%- when 'truck' -%}
      <rect x="2" y="7" width="12" height="9" rx="1"/>
      <path d="M14 10h4.5L21 13.5V16h-7"/>
      <circle cx="7" cy="18.5" r="1.5"/>
      <circle cx="18" cy="18.5" r="1.5"/>

    {%- when 'return' -%}
      <path d="M4 12a8 8 0 0 1 13.7-5.7L20 8"/>
      <polyline points="20 3 20 8 15 8"/>
      <path d="M20 12a8 8 0 0 1-13.7 5.7L4 16"/>
      <polyline points="4 21 4 16 9 16"/>

    {%- when 'shield-check' -%}
      <path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z"/>
      <polyline points="9 12 11.3 14.3 15.5 10"/>

    {%- when 'whatsapp' -%}
      <path fill="currentColor" stroke="none" d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.7-1.2A9 9 0 1 0 12 3Z"/>
      <path fill="var(--color-surface)" stroke="none" d="M8.5 8.8c.2-.5.4-.5.6-.5h.5c.2 0 .4 0 .5.4.2.4.6 1.4.6 1.5.1.1.1.3 0 .4-.1.2-.1.3-.3.4-.1.2-.3.3-.4.5-.2.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1.2-.2.7-.8.9-1.1.2-.2.4-.2.6-.1.2.1 1.5.7 1.7.8.2.1.4.2.4.3 0 .2 0 1-.4 1.4-.4.5-1.3.9-2 .9-.6 0-1.9-.2-3.6-1.4-2.1-1.5-3.4-3.7-3.5-3.9-.1-.2-.9-1.2-.9-2.3 0-1.1.6-1.6.8-1.8Z"/>

    {%- when 'instagram' -%}
      <rect x="3" y="3" width="18" height="18" rx="5"/>
      <circle cx="12" cy="12" r="4"/>
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none"/>

    {%- when 'facebook' -%}
      <path fill="currentColor" stroke="none" d="M14 21v-7h2.4l.4-3H14V9c0-.9.2-1.5 1.5-1.5H17V4.9C16.6 4.8 15.6 4.7 14.4 4.7c-2.4 0-4 1.5-4 4.1V11H8v3h2.4v7h3.6Z"/>

    {%- when 'play' -%}
      <circle cx="12" cy="12" r="9.5"/>
      <polygon points="10 8.5 16 12 10 15.5" fill="currentColor" stroke="none"/>

    {%- when 'filter' -%}
      <line x1="4" y1="6" x2="20" y2="6"/>
      <circle cx="9" cy="6" r="1.8"/>
      <line x1="4" y1="12" x2="20" y2="12"/>
      <circle cx="15" cy="12" r="1.8"/>
      <line x1="4" y1="18" x2="20" y2="18"/>
      <circle cx="11" cy="18" r="1.8"/>

    {%- when 'pin' -%}
      <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"/>
      <circle cx="12" cy="9.5" r="2.3"/>

  {%- endcase -%}
</svg>
