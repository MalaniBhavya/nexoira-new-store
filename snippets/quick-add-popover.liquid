{%- comment -%}
  Shared Quick Add dialog shell, rendered once globally (theme.liquid).
  Populated per-product by assets/quick-add.js when a
  [data-quick-add-trigger] button is clicked anywhere on the page.
  Strings are passed via data attributes since the JS that builds the
  dynamic size-button markup can't call the `t` filter itself.
{%- endcomment -%}

<div class="dialog-backdrop" id="QuickAddBackdrop" data-quick-add-backdrop hidden></div>

<div
  class="dialog-panel quick-add-popover"
  id="QuickAddPopover"
  role="dialog"
  aria-modal="true"
  aria-labelledby="QuickAddTitle"
  data-quick-add-popover
  data-i18n-select-size="{{ 'general.product.select_size' | t }}"
  data-i18n-add-to-cart="{{ 'general.product.add_to_cart' | t }}"
  data-i18n-adding="{{ 'general.product.adding' | t }}"
  data-i18n-added="{{ 'general.product.added' | t }}"
  data-i18n-sold-out="{{ 'general.product.badge_sold_out' | t }}"
  data-i18n-error="{{ 'general.product.add_to_cart_error' | t }}"
  data-i18n-view-cart="{{ 'general.navigation.view_cart' | t }}"
  hidden
>
  <button type="button" class="button--icon dialog-close" data-quick-add-close>
    {%- assign close_label = 'general.accessibility.close' | t -%}
    {%- render 'icon', name: 'close', size: 18, title: close_label -%}
  </button>
  <p id="QuickAddTitle" class="quick-add-popover__title" data-quick-add-title></p>
  <p class="quick-add-popover__price" data-quick-add-price></p>
  <div class="quick-add-popover__sizes" data-quick-add-sizes></div>
  <p class="quick-add-popover__status" data-quick-add-status role="status" aria-live="polite"></p>
</div>
