<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {%- comment -%}
      Faceted collection pages (any filter or non-default sort applied)
      shouldn't compete with the clean collection URL in search results -
      keep them crawlable (follow) but out of the index.
    {%- endcomment -%}
    {%- if template.name == 'collection' and collection -%}
      {%- liquid
        assign has_faceted_state = false
        for filter in collection.filters
          if filter.active_values.size > 0 or filter.min_value.value != nil or filter.max_value.value != nil
            assign has_faceted_state = true
            break
          endif
        endfor
        if collection.sort_by != blank and collection.sort_by != collection.default_sort_by
          assign has_faceted_state = true
        endif
      -%}
      {%- if has_faceted_state -%}
        <meta name="robots" content="noindex, follow">
      {%- endif -%}
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if settings.favicon -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <link rel="preload" href="{{ 'inter-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{ 'playfair-display-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>

    {{ 'tokens.css' | asset_url | stylesheet_tag }}
    {%- render 'theme-tokens' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'components.css' | asset_url | stylesheet_tag }}
    {{ 'product-card.css' | asset_url | stylesheet_tag }}
    {{ 'quick-shop.css' | asset_url | stylesheet_tag }}
    {{ 'cart-drawer.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'global.js' | asset_url }}" defer></script>
    <script src="{{ 'cart-store.js' | asset_url }}" defer></script>
    <script src="{{ 'wishlist-store.js' | asset_url }}" defer></script>
    <script src="{{ 'recently-viewed.js' | asset_url }}" defer></script>
    <script src="{{ 'quick-add.js' | asset_url }}" defer></script>
    <script src="{{ 'quick-view.js' | asset_url }}" defer></script>
    <script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handleize }}">
    <a class="skip-link" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- render 'quick-add-popover' -%}
    {%- render 'quick-view-modal' -%}
    {%- render 'cart-drawer' -%}
  </body>
</html>
