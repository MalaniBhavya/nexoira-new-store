{%- doc -%}
  Four-up benefits grid communicating the brand's core value
  proposition.
{%- enddoc -%}

<section class="why-nexoira" data-section-id="{{ section.id }}" data-section-type="why-nexoira">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading section-heading--center">
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="why-nexoira__grid">
        {%- for block in section.blocks -%}
          <div class="why-nexoira__item" {{ block.shopify_attributes }}>
            <div class="why-nexoira__icon">
              {%- liquid
                case block.settings.icon
                  when 'fit'
                    render 'icon-feature-fit'
                  when 'price'
                    render 'icon-feature-price'
                  when 'india'
                    render 'icon-feature-india'
                  else
                    render 'icon-feature-fabric'
                endcase
              -%}
            </div>
            <h3 class="why-nexoira__title">{{ block.settings.heading }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="why-nexoira__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Why Nexoira",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Nexoira"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "fabric",
              "label": "Fabric"
            },
            {
              "value": "fit",
              "label": "Fit"
            },
            {
              "value": "price",
              "label": "Price"
            },
            {
              "value": "india",
              "label": "India"
            }
          ],
          "default": "fabric"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "benefit",
        "settings": {
          "icon": "fabric",
          "heading": "QUALITY YOU CAN FEEL",
          "text": "Carefully selected fabrics designed for everyday comfort."
        }
      },
      {
        "type": "benefit",
        "settings": {
          "icon": "india",
          "heading": "MADE FOR EVERYDAY",
          "text": "Versatile clothing designed for real life."
        }
      },
      {
        "type": "benefit",
        "settings": {
          "icon": "fit",
          "heading": "MODERN FIT",
          "text": "Contemporary silhouettes for the modern Indian man."
        }
      },
      {
        "type": "benefit",
        "settings": {
          "icon": "price",
          "heading": "FAIRLY PRICED",
          "text": "Better quality without unnecessary markups."
        }
      }
    ]
  }
}
{% endschema %}
