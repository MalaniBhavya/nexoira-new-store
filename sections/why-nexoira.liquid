{%- comment -%}
  Four-up benefits grid communicating the brand's core value
  proposition.
{%- endcomment -%}

<section class="why-nexoira" data-section-id="{{ section.id }}" data-section-type="why-nexoira">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading section-heading--center" data-reveal>
        <div class="section-heading__text">
          <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
          {%- if section.settings.subheading != blank -%}
            <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="why-nexoira__grid">
        {%- for block in section.blocks -%}
          {%- assign reveal_delay = forloop.index0 | at_most: 5 | times: 90 -%}
          <div class="why-nexoira__item" data-reveal style="--reveal-delay: {{ reveal_delay }}ms;" {{ block.shopify_attributes }}>
            <div class="why-nexoira__icon">
              {%- liquid
                case block.settings.icon
                  when 'returns'
                    render 'icon-feature-returns'
                  when 'cod'
                    render 'icon-feature-cod'
                  when 'secure'
                    render 'icon-feature-secure'
                  when 'fabric'
                    render 'icon-feature-fabric'
                  when 'fit'
                    render 'icon-feature-fit'
                  else
                    render 'icon-feature-shipping'
                endcase
              -%}
            </div>
            <h3 class="why-nexoira__title">{{ block.settings.heading }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="why-nexoira__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Why Nexoira",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Nexoira"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Supporting text"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "returns",
              "label": "Returns"
            },
            {
              "value": "cod",
              "label": "Cash on delivery"
            },
            {
              "value": "secure",
              "label": "Secure payments"
            },
            {
              "value": "fabric",
              "label": "Fabric"
            },
            {
              "value": "fit",
              "label": "Fit"
            }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "benefit",
        "settings": {
          "icon": "shipping",
          "heading": "Free shipping",
          "text": "On orders above ₹999"
        }
      },
      {
        "type": "benefit",
        "settings": {
          "icon": "returns",
          "heading": "7-day returns",
          "text": "Simple and convenient"
        }
      },
      {
        "type": "benefit",
        "settings": {
          "icon": "cod",
          "heading": "COD available",
          "text": "Across eligible pincodes"
        }
      },
      {
        "type": "benefit",
        "settings": {
          "icon": "secure",
          "heading": "Secure payments",
          "text": "UPI, cards, net banking & more"
        }
      }
    ]
  }
}
{% endschema %}
