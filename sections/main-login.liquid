<div class="account-page container">
  <div id="Login" class="account-form-wrap">
    <h1 class="account-page__heading">{{ 'general.customer.sign_in' | t }}</h1>
    {%- form 'customer_login', class: 'account-form' -%}
      {%- if form.errors -%}
        <p class="field__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="CustomerEmail">{{ 'general.customer.email' | t }}</label>
        <input type="email" id="CustomerEmail" name="customer[email]" class="input" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="CustomerPassword">{{ 'general.customer.password' | t }}</label>
        <input type="password" id="CustomerPassword" name="customer[password]" class="input" autocomplete="current-password" required>
      </div>
      <button type="submit" class="button--primary button--full">{{ 'general.customer.sign_in' | t }}</button>
      <a href="#RecoverPassword" class="button--tertiary account-form__toggle">{{ 'general.customer.forgot_password' | t }}</a>
    {%- endform -%}

    <p class="account-page__alt">
      <a href="{{ routes.account_register_url }}">{{ 'general.customer.create_account' | t }}</a>
    </p>
  </div>

  <div id="RecoverPassword" class="account-form-wrap account-form-wrap--recover">
    <h1 class="account-page__heading">{{ 'general.customer.reset_password_heading' | t }}</h1>
    <p class="account-page__intro">{{ 'general.customer.reset_password_body' | t }}</p>
    {%- form 'recover_customer_password', class: 'account-form' -%}
      {%- if form.posted_successfully? -%}
        <p class="account-form__success" role="status">{{ 'general.customer.reset_sent' | t }}</p>
      {%- else -%}
        {%- if form.errors -%}
          <p class="field__error">{{ form.errors | default_errors }}</p>
        {%- endif -%}
        <div class="field">
          <label class="field__label" for="RecoverEmail">{{ 'general.customer.email' | t }}</label>
          <input type="email" id="RecoverEmail" name="email" class="input" autocomplete="email" required>
        </div>
        <button type="submit" class="button--primary button--full">{{ 'general.customer.submit_reset' | t }}</button>
      {%- endif -%}
    {%- endform -%}
    <a href="#Login" class="button--tertiary account-form__toggle">{{ 'general.customer.sign_in' | t }}</a>
  </div>
</div>

{% stylesheet %}
  .account-page {
    padding-block: var(--space-8) var(--section-spacing-y);
    display: flex;
    justify-content: center;
  }

  .account-form-wrap {
    width: 100%;
    max-width: 400px;
  }

  .account-form-wrap--recover {
    display: none;
  }

  .account-form-wrap--recover:target {
    display: block;
  }

  #Login:has(~ #RecoverPassword:target) {
    display: none;
  }

  .account-page__heading {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .account-page__intro {
    color: var(--color-ink-muted);
    margin-bottom: var(--space-4);
    text-align: center;
  }

  .account-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .account-form__toggle {
    align-self: center;
  }

  .account-form__success {
    color: var(--color-success);
    font-weight: 600;
    text-align: center;
  }

  .account-page__alt {
    text-align: center;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Login page"
}
{% endschema %}
