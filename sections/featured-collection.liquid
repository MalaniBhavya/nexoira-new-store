{%- comment -%}
  Product rail pulling from a merchant-selected collection.

  One implementation serves every product row on the homepage — New
  Arrivals, The Shirt Edit, Most Wanted — with a layout choice between a
  grid and a scroll-snap carousel. Mobile shows two across in grid mode,
  which is what a phone can read comfortably at this image ratio.
{%- endcomment -%}

{%- liquid
  assign target = section.settings.collection
  assign is_carousel = false
  if section.settings.layout == 'carousel'
    assign is_carousel = true
  endif
-%}

<section
  class="featured-collection featured-collection--{{ section.settings.layout }}"
  data-section-id="{{ section.id }}"
  data-section-type="featured-collection"
>
  <div class="container">
    <div class="section-heading{% if section.settings.heading_alignment == 'center' %} section-heading--center{% endif %}" data-reveal>
      <div class="section-heading__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- if target != blank and section.settings.show_view_all -%}
        <a href="{{ target.url }}" class="section-heading__link">
          {{ section.settings.view_all_label | default: 'View all' }}
          {%- render 'icon-arrow-right' -%}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if target != blank and target.products.size > 0 -%}
    {%- if is_carousel -%}
      <div class="product-carousel" data-product-carousel>
        <div class="product-carousel__track">
          {%- for product in target.products limit: section.settings.products_to_show -%}
            {%- assign reveal_delay = forloop.index0 | at_most: 5 | times: 90 -%}
            <div class="product-carousel__item" data-reveal style="--reveal-delay: {{ reveal_delay }}ms;">
              {%- render 'card-product', product: product, sizes: '(min-width: 990px) 22vw, 70vw' -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="container">
        <div class="product-grid" style="--grid-columns: {{ section.settings.columns_desktop }};">
          {%- for product in target.products limit: section.settings.products_to_show -%}
            {%- render 'card-product', product: product, reveal_index: forloop.index0 -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

  {%- elsif request.design_mode -%}
    {%- comment -%}
      Only surface setup guidance inside the editor — a live shopper
      should never see an empty-state instruction aimed at the merchant.
    {%- endcomment -%}
    <div class="container">
      <p class="section-placeholder">Choose a collection for this section in the theme editor.</p>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Product rail",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Supporting text"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        { "value": "start", "label": "Left" },
        { "value": "center", "label": "Centred" }
      ],
      "default": "start"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Swipeable carousel" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "info": "Grid layout only.",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show the view all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Product rail"
    }
  ]
}
{% endschema %}
