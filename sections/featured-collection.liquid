{%- doc -%}
  Premium product grid pulling from a merchant-selected collection.
  Used for "New Arrivals" on the homepage but reusable anywhere.
{%- enddoc -%}

<section class="featured-collection" data-section-id="{{ section.id }}" data-section-type="featured-collection">
  <div class="container">
    <div class="section-heading" data-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.collection != blank -%}
        <a href="{{ section.settings.collection.url }}" class="section-heading__link">View all</a>
      {%- endif -%}
    </div>

    {%- if section.settings.collection != blank and section.settings.collection.products.size > 0 -%}
      <div class="product-grid" style="--grid-columns: {{ section.settings.columns_desktop }};">
        {%- for product in section.settings.collection.products limit: section.settings.products_to_show -%}
          {%- render 'card-product', product: product, reveal_index: forloop.index0 -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="featured-collection__empty">Select a collection in the theme customizer to display products here.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Arrivals"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
