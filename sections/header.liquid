<header
  class="site-header{% if request.page_type == 'index' %} site-header--transparent{% endif %}"
  data-header
  data-section-id="{{ section.id }}"
  data-section-type="header"
>
  <div class="site-header__row container">

    <div class="site-header__side site-header__side--left">
      <nav class="site-header__nav">
        {%- for link in section.settings.menu.links -%}
          {%- assign link_title_down = link.title | downcase -%}
          {%- if link_title_down == 'shirts' or link_title_down == 'trousers' or link_title_down == 'kurtas' -%}
            <a href="{{ link.url }}" class="site-header__nav-link">{{ link.title }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <button
        type="button"
        class="site-header__menu-toggle"
        data-mobile-nav-toggle
        aria-expanded="false"
        aria-controls="MobileNav-{{ section.id }}"
      >
        {%- render 'icon-menu' -%}
        <span class="visually-hidden">{{ 'general.menu.open' | t }}</span>
      </button>
    </div>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 320 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round }}"
          loading="eager"
        >
      {%- else -%}
        <span class="site-header__logo-text">Nexoira</span>
      {%- endif -%}
    </a>

    <div class="site-header__side site-header__side--right">
      <button
        type="button"
        class="site-header__action"
        data-search-toggle
        aria-expanded="false"
        aria-controls="HeaderSearch-{{ section.id }}"
      >
        {%- render 'icon-search' -%}
        <span class="visually-hidden">{{ 'general.search.submit' | t }}</span>
      </button>
      <a href="{{ routes.account_url }}" class="site-header__action" aria-label="Account">
        {%- render 'icon-account' -%}
      </a>
      <a
        href="{{ routes.cart_url }}"
        class="site-header__action site-header__cart"
        aria-label="{{ 'cart.general.title' | t }}"
        data-cart-drawer-open
      >
        {%- render 'icon-cart' -%}
        <span class="site-header__cart-count" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>

  </div>

  <div class="site-header__search-panel" id="HeaderSearch-{{ section.id }}" data-search-panel>
    <form action="{{ routes.search_url }}" method="get" role="search" class="site-header__search-form container">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="{{ 'general.search.placeholder' | t }}"
        autocomplete="off"
        data-search-input
      >
      <button type="submit" aria-label="{{ 'general.search.submit' | t }}">
        {%- render 'icon-search' -%}
      </button>
    </form>
  </div>
</header>

<div class="mobile-nav" id="MobileNav-{{ section.id }}" data-mobile-nav>
  <div class="mobile-nav__header">
    <a href="{{ routes.root_url }}" class="mobile-nav__logo">Nexoira</a>
    <button type="button" data-mobile-nav-close aria-label="{{ 'general.menu.close' | t }}">
      {%- render 'icon-close' -%}
    </button>
  </div>
  <nav class="mobile-nav__body">
    <p class="mobile-nav__label">Shop</p>
    <ul class="mobile-nav__list">
      {%- for link in section.settings.menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
    <div class="mobile-nav__actions">
      <a href="{{ routes.search_url }}">{{ 'general.search.submit' | t }}</a>
      <a href="{{ routes.account_url }}">Account</a>
    </div>
  </nav>
</div>
<div class="mobile-nav-overlay" data-mobile-nav-overlay></div>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 80,
      "max": 260,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Shop menu",
      "info": "Shirts/Trousers/Kurtas links are shown in the header nav; the full list is shown in the mobile menu.",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
