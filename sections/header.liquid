<header class="site-header" data-section-id="{{ section.id }}" data-section-type="header">
  <div class="site-header__inner container">

    <button type="button" class="site-header__menu-toggle" aria-expanded="false" aria-controls="SiteNav">
      <span class="visually-hidden">{{ 'general.menu.open' | t }}</span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
      <span class="icon-bar"></span>
    </button>

    <a href="{{ routes.root_url }}" class="site-header__logo">
      {%- if section.settings.logo != blank -%}
        <img
          src="{{ section.settings.logo | image_url: width: 300 }}"
          alt="{{ shop.name }}"
          width="{{ section.settings.logo_width }}"
          height="{{ section.settings.logo_width | divided_by: section.settings.logo.aspect_ratio | round }}"
          loading="eager"
        >
      {%- else -%}
        <span class="site-header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav id="SiteNav" class="site-header__nav" aria-label="Primary">
      <ul class="site-header__nav-list">
        {%- for link in section.settings.main_menu.links -%}
          <li class="site-header__nav-item">
            <a href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>{{ link.title }}</a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="{{ routes.search_url }}" class="site-header__action" aria-label="{{ 'general.search.submit' | t }}">
        {%- render 'icon-search' -%}
      </a>
      <a href="{{ routes.account_url }}" class="site-header__action" aria-label="Account">
        {%- render 'icon-account' -%}
      </a>
      <a href="{{ routes.cart_url }}" class="site-header__action site-header__cart" aria-label="{{ 'cart.general.title' | t }}">
        {%- render 'icon-cart' -%}
        <span class="site-header__cart-count">{{ cart.item_count }}</span>
      </a>
    </div>

  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 10,
      "unit": "px",
      "default": 140
    },
    {
      "type": "link_list",
      "id": "main_menu",
      "label": "Menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
