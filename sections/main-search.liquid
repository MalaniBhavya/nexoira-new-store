{%- comment -%}
  Search results, with a no-results state that offers merchant-chosen
  collections instead of a dead end. Uses the same predictive search
  field as the header so suggestions work here too.
{%- endcomment -%}

<div class="search-page" data-section-id="{{ section.id }}" data-section-type="main-search">
  <div class="container">
    {%- render 'breadcrumbs' -%}

    <div class="search-page__header">
      <h1 class="search-page__title">{{ 'general.search.title' | t }}</h1>
      {%- render 'predictive-search', section_id: section.id -%}
    </div>

    {%- if search.performed -%}
      {%- if search.results.size > 0 -%}
        {%- paginate search.results by 24 -%}
          <p class="search-page__count">
            {{ 'general.search.results_for' | t: count: search.results_count, terms: search.terms }}
          </p>

          <div class="product-grid" style="--grid-columns: 4;">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {%- liquid
                  assign card_loading = 'lazy'
                  if forloop.index <= 4
                    assign card_loading = 'eager'
                  endif
                -%}
                {%- render 'card-product', product: item, image_loading: card_loading -%}
              {%- else -%}
                <a href="{{ item.url }}" class="search-page__other-result">
                  <h3>{{ item.title }}</h3>
                  <p>{{ item.content | strip_html | truncatewords: 20 }}</p>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>

          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="{{ 'collections.general.pagination_label' | t }}">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="pagination__link" aria-label="{{ 'accessibility.previous' | t }}">
                  {%- render 'icon-arrow-left' -%}
                </a>
              {%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a href="{{ part.url }}" class="pagination__link">{{ part.title }}</a>
                {%- else -%}
                  <span class="pagination__current">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="pagination__link" aria-label="{{ 'accessibility.next' | t }}">
                  {%- render 'icon-arrow-right' -%}
                </a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <div class="search-page__empty">
          <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>

          {%- if section.blocks.size > 0 -%}
            <p class="search-page__empty-label">You might like</p>
            <div class="category-showcase__grid">
              {%- for block in section.blocks -%}
                {%- if block.settings.collection != blank -%}
                  <a href="{{ block.settings.collection.url }}" class="category-card" {{ block.shopify_attributes }}>
                    <div class="category-card__media">
                      {%- if block.settings.collection.featured_image -%}
                        <img
                          src="{{ block.settings.collection.featured_image | image_url: width: 800 }}"
                          alt="{{ block.settings.collection.title | escape }}"
                          width="{{ block.settings.collection.featured_image.width }}"
                          height="{{ block.settings.collection.featured_image.height }}"
                          loading="lazy"
                        >
                      {%- else -%}
                        <div class="category-card__placeholder"></div>
                      {%- endif -%}
                    </div>
                    <div class="category-card__info">
                      <h3 class="category-card__title">{{ block.settings.collection.title }}</h3>
                      <span class="category-card__link">Shop now</span>
                    </div>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Search results",
  "settings": [

  ],
  "blocks": [
    {
      "type": "suggested_collection",
      "name": "Suggested collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "suggested_collection"
      },
      {
        "type": "suggested_collection"
      },
      {
        "type": "suggested_collection"
      }
    ]
  }
}
{% endschema %}
