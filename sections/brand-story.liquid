{%- doc -%}
  Sophisticated editorial statement section carrying the core brand
  narrative, with an optional supporting image.
{%- enddoc -%}

<section class="brand-story" data-section-id="{{ section.id }}" data-section-type="brand-story">
  <div class="container brand-story__inner">
    <div class="brand-story__content" data-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="brand-story__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="brand-story__body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--outline">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>

    {%- if section.settings.image != blank -%}
      <div class="brand-story__media" data-reveal="image">
        <img
          src="{{ section.settings.image | image_url: width: 1000 }}"
          srcset="
            {{ section.settings.image | image_url: width: 500 }} 500w,
            {{ section.settings.image | image_url: width: 800 }} 800w,
            {{ section.settings.image | image_url: width: 1000 }} 1000w
          "
          sizes="(min-width: 990px) 40vw, 100vw"
          alt="{{ section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image (optional)"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR PHILOSOPHY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE NEW FACE OF TRADITION."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Nexoira was created with a simple belief — great style should not come at an unreasonable price.</p><p>We combine contemporary design, everyday comfort and timeless Indian sensibilities to create clothing for the modern man.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "OUR STORY"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Brand story"
    }
  ]
}
{% endschema %}
