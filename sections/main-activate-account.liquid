<div class="customer-activate-account container" data-section-id="{{ section.id }}" data-section-type="main-activate-account">
  <div class="auth-card">
    <div class="section-heading section-heading--center">
      <h1 class="section-heading__title">Activate Account</h1>
      <p class="faq-page__subtext">Create a password to activate your account.</p>
    </div>

    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label for="ActivatePassword">Password</label>
      <input type="password" name="customer[password]" id="ActivatePassword" autocomplete="new-password">

      <label for="ActivatePasswordConfirmation">Confirm password</label>
      <input type="password" name="customer[password_confirmation]" id="ActivatePasswordConfirmation" autocomplete="new-password">

      <div class="auth-card__actions">
        <button type="submit" name="decline" class="button button--outline">Decline invitation</button>
        <button type="submit" class="button button--solid">Activate account</button>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Activate account",
  "settings": [

  ]
}
{% endschema %}
