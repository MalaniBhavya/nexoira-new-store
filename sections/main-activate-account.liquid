<div class="account-page container">
  <div class="account-form-wrap">
    <h1 class="account-page__heading">{{ 'general.customer.activate_account_heading' | t }}</h1>
    <p class="account-page__intro">{{ 'general.customer.activate_account_body' | t }}</p>
    {%- form 'activate_customer_password', class: 'account-form' -%}
      {%- if form.errors -%}
        <p class="field__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="ActivatePassword">{{ 'general.customer.password' | t }}</label>
        <input type="password" id="ActivatePassword" name="customer[password]" class="input" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ActivatePasswordConfirm">{{ 'general.customer.confirm_password' | t }}</label>
        <input type="password" id="ActivatePasswordConfirm" name="customer[password_confirmation]" class="input" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button--primary button--full">{{ 'general.customer.activate' | t }}</button>
      <button type="submit" name="decline" class="button--tertiary">{{ 'general.customer.decline' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .account-form-wrap {
    width: 100%;
    max-width: 400px;
  }

  .account-page__intro {
    color: var(--color-ink-muted);
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .account-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Activate account page"
}
{% endschema %}
