{%- doc -%}
  Editorial masonry-style image gallery for social / styling content.
{%- enddoc -%}

<section class="style-gallery" data-section-id="{{ section.id }}" data-section-type="style-gallery">
  <div class="container">
    <div class="section-heading section-heading--center">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.handle != blank -%}
        <a
          href="{{ section.settings.handle_link | default: settings.social_instagram_link | default: '#' }}"
          class="style-gallery__handle"
        >
          {%- render 'icon-instagram' -%}
          <span>{{ section.settings.handle }}</span>
        </a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="style-gallery__grid">
        {%- for block in section.blocks -%}
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="style-gallery__item" {{ block.shopify_attributes }}>
          {%- else -%}
            <div class="style-gallery__item" {{ block.shopify_attributes }}>
          {%- endif -%}

            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 400 }} 400w,
                  {{ block.settings.image | image_url: width: 600 }} 600w,
                  {{ block.settings.image | image_url: width: 800 }} 800w
                "
                sizes="(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw"
                alt=""
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="style-gallery__placeholder"></div>
            {%- endif -%}

          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Style gallery",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Styled by Nexoira"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle text",
      "default": "@nexoira"
    },
    {
      "type": "url",
      "id": "handle_link",
      "label": "Handle link",
      "info": "Defaults to the Instagram URL set in theme settings."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "image"
      },
      {
        "type": "image"
      },
      {
        "type": "image"
      },
      {
        "type": "image"
      },
      {
        "type": "image"
      },
      {
        "type": "image"
      }
    ]
  },
  "presets": [
    {
      "name": "Style gallery"
    }
  ]
}
{% endschema %}
