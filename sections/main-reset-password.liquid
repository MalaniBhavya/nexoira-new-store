<div class="account-page container">
  <div class="account-form-wrap">
    <h1 class="account-page__heading">{{ 'general.customer.reset_password_heading' | t }}</h1>
    {%- form 'reset_customer_password', class: 'account-form' -%}
      {%- if form.errors -%}
        <p class="field__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="ResetPassword">{{ 'general.customer.new_password' | t }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" class="input" autocomplete="new-password" required>
      </div>
      <div class="field">
        <label class="field__label" for="ResetPasswordConfirm">{{ 'general.customer.confirm_password' | t }}</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" class="input" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button--primary button--full">{{ 'general.customer.submit_reset' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .account-form-wrap {
    width: 100%;
    max-width: 400px;
  }

  .account-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reset password page"
}
{% endschema %}
