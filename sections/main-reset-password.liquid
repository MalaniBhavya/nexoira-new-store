<div class="customer-reset-password container">
  {%- form 'reset_customer_password' -%}
    <label for="ResetPassword">New password</label>
    <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password">

    <label for="ResetPasswordConfirmation">Confirm new password</label>
    <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirmation" autocomplete="new-password">

    <button type="submit">Reset password</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": [

  ]
}
{% endschema %}
