<div class="customer-reset-password container" data-section-id="{{ section.id }}" data-section-type="main-reset-password">
  <div class="auth-card">
    <div class="section-heading section-heading--center">
      <h1 class="section-heading__title">Reset Password</h1>
      <p class="faq-page__subtext">Enter a new password for your account.</p>
    </div>

    {%- form 'reset_customer_password' -%}
      {%- if form.errors -%}
        <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label for="ResetPassword">New password</label>
      <input type="password" name="customer[password]" id="ResetPassword" autocomplete="new-password">

      <label for="ResetPasswordConfirmation">Confirm new password</label>
      <input type="password" name="customer[password_confirmation]" id="ResetPasswordConfirmation" autocomplete="new-password">

      <button type="submit" class="button button--solid">Reset password</button>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": [

  ]
}
{% endschema %}
