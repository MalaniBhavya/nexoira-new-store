{%- doc -%}
  Three large editorial category cards linking to the brand's core
  product lines.
{%- enddoc -%}

<section class="category-showcase" data-section-id="{{ section.id }}" data-section-type="shop-by-category">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-heading" data-reveal>
        <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="category-showcase__grid" style="--category-count: {{ section.blocks.size }};">
        {%- for block in section.blocks -%}
          {%- assign reveal_delay = forloop.index0 | at_most: 5 | times: 90 -%}
          <a
            href="{{ block.settings.link | default: '#' }}"
            class="category-card"
            data-reveal
            style="--reveal-delay: {{ reveal_delay }}ms;"
            {{ block.shopify_attributes }}
          >
            <div class="category-card__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 1000 }}"
                  srcset="
                    {{ block.settings.image | image_url: width: 500 }} 500w,
                    {{ block.settings.image | image_url: width: 800 }} 800w,
                    {{ block.settings.image | image_url: width: 1000 }} 1000w,
                    {{ block.settings.image | image_url: width: 1400 }} 1400w
                  "
                  sizes="(min-width: 990px) 33vw, 100vw"
                  alt="{{ block.settings.heading | escape }}"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                  loading="lazy"
                >
              {%- else -%}
                <div class="category-card__placeholder"></div>
              {%- endif -%}
            </div>
            <div class="category-card__info">
              <h3 class="category-card__title">{{ block.settings.heading }}</h3>
              {%- if block.settings.subtext != blank -%}
                <p class="category-card__subtext">{{ block.settings.subtext }}</p>
              {%- endif -%}
              <span class="category-card__link">Shop now</span>
            </div>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "category",
        "settings": {
          "heading": "SHIRTS",
          "subtext": "Modern essentials for every day.",
          "link": "/collections/shirts"
        }
      },
      {
        "type": "category",
        "settings": {
          "heading": "TROUSERS",
          "subtext": "Comfort meets contemporary style.",
          "link": "/collections/pants"
        }
      },
      {
        "type": "category",
        "settings": {
          "heading": "KURTAS",
          "subtext": "Tradition for the modern man.",
          "link": "/collections/kurtas"
        }
      }
    ]
  }
}
{% endschema %}
