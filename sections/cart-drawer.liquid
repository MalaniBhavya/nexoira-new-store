{%- doc -%}
  Global slide-out cart drawer. Rendered once in layout/theme.liquid.
  Re-fetched wholesale via the cart endpoints' `sections` parameter
  after every add/change so it always reflects the live cart.
{%- enddoc -%}

<div class="cart-drawer" data-cart-drawer data-cart-item-count="{{ cart.item_count }}" aria-hidden="true">
  <div class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.general.title' | t }}">
    <div class="cart-drawer__header">
      <h2 class="cart-drawer__title">
        {{ 'cart.general.title' | t }}{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
      </h2>
      <button type="button" class="cart-drawer__close" data-cart-drawer-close aria-label="{{ 'general.menu.close' | t }}">
        {%- render 'icon-close' -%}
      </button>
    </div>

    <div class="cart-drawer__content">
      {%- if cart.item_count > 0 -%}
        <ul class="cart-drawer__items">
          {%- for item in cart.items -%}
            <li class="cart-drawer__item">
              <a href="{{ item.url }}" class="cart-drawer__item-media" data-cart-drawer-close>
                {%- if item.image -%}
                  <img
                    src="{{ item.image | image_url: width: 200 }}"
                    alt="{{ item.image.alt | escape }}"
                    width="100"
                    height="126"
                    loading="lazy"
                  >
                {%- endif -%}
              </a>
              <div class="cart-drawer__item-info">
                <a href="{{ item.url }}" class="cart-drawer__item-title" data-cart-drawer-close>{{ item.product.title }}</a>
                {%- unless item.variant.title == 'Default Title' -%}
                  <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
                {%- endunless -%}
                <div class="cart-drawer__item-price">
                  {%- if item.original_line_price != item.final_line_price -%}
                    <span class="cart-drawer__item-price--sale">{{ item.final_line_price | money }}</span>
                    <span class="cart-drawer__item-price--compare">{{ item.original_line_price | money }}</span>
                  {%- else -%}
                    <span>{{ item.final_line_price | money }}</span>
                  {%- endif -%}
                </div>
                <div class="cart-drawer__item-quantity">
                  <button type="button" class="cart-drawer__qty-btn" data-cart-qty="decrease" data-line="{{ forloop.index }}" aria-label="Decrease quantity">
                    &minus;
                  </button>
                  <span class="cart-drawer__qty-value">{{ item.quantity }}</span>
                  <button type="button" class="cart-drawer__qty-btn" data-cart-qty="increase" data-line="{{ forloop.index }}" aria-label="Increase quantity">
                    +
                  </button>
                </div>
              </div>
              <button
                type="button"
                class="cart-drawer__item-remove"
                data-cart-remove
                data-line="{{ forloop.index }}"
                aria-label="{{ 'cart.general.remove' | t }} {{ item.product.title }}"
              >
                {%- render 'icon-close' -%}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="cart-drawer__empty">
          <p>{{ 'cart.general.empty' | t }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="button button--outline" data-cart-drawer-close>
            {{ 'cart.general.continue_shopping' | t }}
          </a>
        </div>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer__footer">
        {%- if section.settings.shipping_note != blank -%}
          <p class="cart-drawer__shipping-note">{{ section.settings.shipping_note }}</p>
        {%- endif -%}
        <div class="cart-drawer__subtotal">
          <span>{{ 'cart.label.total' | t }}</span>
          <span>{{ cart.total_price | money }}</span>
        </div>
        <a href="{{ routes.cart_url }}" class="button button--outline cart-drawer__view-cart" data-cart-drawer-close>
          View cart
        </a>
        <a href="/checkout" class="button button--solid cart-drawer__checkout">
          {{ 'cart.checkout.button' | t }}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>
<div class="cart-drawer-overlay" data-cart-drawer-overlay></div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": [
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Shipping note",
      "default": "Free shipping on orders above ₹999"
    }
  ]
}
{% endschema %}
