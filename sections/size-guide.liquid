{%- doc -%}
  Size guide modal, included on the product template and opened from the
  "Size guide" link beside the size selector.

  Charts are per-garment blocks, so nothing is hard-coded in the template.
  A single product can override them all with a `custom.size_guide`
  metafield (rich text or a metaobject with a `chart` field), which is
  what a made-to-order or oddly-sized piece needs.
{%- enddoc -%}

{%- liquid
  assign product_guide = blank
  assign guide_metafield = product.metafields.custom.size_guide
  if guide_metafield != blank
    if guide_metafield.type == 'metaobject_reference'
      assign product_guide = guide_metafield.value.chart
    else
      assign product_guide = guide_metafield.value
    endif
  endif
-%}

<dialog class="size-guide" data-size-guide-dialog aria-label="{{ section.settings.heading }}">
  <div class="size-guide__header">
    <h2>{{ section.settings.heading }}</h2>
    <button type="button" class="size-guide__close" data-size-guide-close aria-label="{{ 'accessibility.close' | t }}">
      {%- render 'icon-close' -%}
    </button>
  </div>

  {%- if product_guide != blank -%}
    {%- comment -%} A product-level chart wins over the generic ones. {%- endcomment -%}
    <div class="size-guide__body">
      <div class="size-guide__panel rte">{{ product_guide }}</div>
    </div>
  {%- elsif section.blocks.size > 0 -%}
    <div class="size-guide__tabs" role="tablist">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="size-guide__tab{% if forloop.first %} is-active{% endif %}"
          data-size-guide-tab="{{ block.settings.category_key }}"
          role="tab"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
        >
          {{ block.settings.category_name }}
        </button>
      {%- endfor -%}
    </div>

    <div class="size-guide__body">
      {%- for block in section.blocks -%}
        {%- liquid
          assign columns = block.settings.columns | split: ','
          assign rows = block.settings.rows | newline_to_br | split: '<br />'
        -%}
        <div
          class="size-guide__panel"
          data-size-guide-panel="{{ block.settings.category_key }}"
          {% unless forloop.first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.note != blank -%}
            <p class="size-guide__note">{{ block.settings.note }}</p>
          {%- endif -%}
          <div class="size-guide__table-wrap">
            <table class="size-guide__table">
              <thead>
                <tr>
                  {%- for column in columns -%}
                    <th>{{ column | strip }}</th>
                  {%- endfor -%}
                </tr>
              </thead>
              <tbody>
                {%- for row in rows -%}
                  {%- assign row = row | strip -%}
                  {%- if row != blank -%}
                    <tr>
                      {%- assign cells = row | split: ',' -%}
                      {%- for cell in cells -%}
                        <td>{{ cell | strip }}</td>
                      {%- endfor -%}
                    </tr>
                  {%- endif -%}
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</dialog>

{% schema %}
{
  "name": "Size guide",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Size guide"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "category_key",
          "label": "Matches product type containing",
          "info": "Lowercase keyword, e.g. \"shirt\". Used to auto-select this tab from the product page.",
          "default": "shirt"
        },
        {
          "type": "text",
          "id": "category_name",
          "label": "Tab label",
          "default": "Shirts"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "All measurements are in inches."
        },
        {
          "type": "text",
          "id": "columns",
          "label": "Column headers (comma separated)",
          "default": "Size, Chest, Length, Sleeve"
        },
        {
          "type": "textarea",
          "id": "rows",
          "label": "Rows (one per line, comma separated)",
          "default": "S, 38, 27, 24\nM, 40, 28, 24.5\nL, 42, 29, 25\nXL, 44, 30, 25.5\nXXL, 46, 31, 26\n3XL, 48, 32, 26.5"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "category",
        "settings": {
          "category_key": "shirt",
          "category_name": "Shirts",
          "note": "All measurements are in inches.",
          "columns": "Size, Chest, Length, Sleeve",
          "rows": "S, 38, 27, 24\nM, 40, 28, 24.5\nL, 42, 29, 25\nXL, 44, 30, 25.5\nXXL, 46, 31, 26\n3XL, 48, 32, 26.5"
        }
      },
      {
        "type": "category",
        "settings": {
          "category_key": "trouser",
          "category_name": "Trousers",
          "note": "All measurements are in inches.",
          "columns": "Size, Waist, Hip, Inseam",
          "rows": "28, 28, 36, 40\n30, 30, 38, 40.5\n32, 32, 40, 41\n34, 34, 42, 41.5\n36, 36, 44, 42"
        }
      },
      {
        "type": "category",
        "settings": {
          "category_key": "kurta",
          "category_name": "Kurtas",
          "note": "All measurements are in inches.",
          "columns": "Size, Chest, Length, Shoulder",
          "rows": "S, 38, 42, 17\nM, 40, 43, 17.5\nL, 42, 44, 18\nXL, 44, 45, 18.5\nXXL, 46, 46, 19\n3XL, 48, 47, 19.5"
        }
      }
    ]
  }
}
{% endschema %}
