{%- comment -%}
  Customer reviews.

  This theme does not ship review content and will not invent any. The
  section renders one of two things:

  1. An app block, if a review app is installed and added here.
  2. Merchant-entered quotes, each of which must be a real customer's
     words that the merchant has permission to publish.

  With neither, the section renders nothing at all on the storefront, so
  it can sit in the homepage ready for the day reviews exist. There is no
  placeholder rating and no aggregateRating schema — see
  snippets/structured-data.liquid.
{%- endcomment -%}

{%- liquid
  assign app_blocks = 0
  assign quote_blocks = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_blocks = app_blocks | plus: 1
    elsif block.type == 'quote' and block.settings.quote != blank
      assign quote_blocks = quote_blocks | plus: 1
    endif
  endfor

  assign has_content = false
  if app_blocks > 0 or quote_blocks > 0
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  <section class="reviews-section" data-section-id="{{ section.id }}" data-section-type="customer-reviews">
    <div class="container">
      <div class="section-heading section-heading--center" data-reveal>
        <div class="section-heading__text">
          {%- if section.settings.heading != blank -%}
            <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if app_blocks > 0 -%}
        <div class="reviews-section__app">
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {%- render block -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

      {%- elsif quote_blocks > 0 -%}
        <ul class="reviews-section__grid">
          {%- for block in section.blocks -%}
            {%- if block.type != 'quote' or block.settings.quote == blank -%}{%- continue -%}{%- endif -%}
            {%- assign reveal_delay = forloop.index0 | at_most: 3 | times: 90 -%}
            <li class="review-card" data-reveal style="--reveal-delay: {{ reveal_delay }}ms;" {{ block.shopify_attributes }}>
              <blockquote class="review-card__quote">{{ block.settings.quote }}</blockquote>
              <div class="review-card__meta">
                {%- if block.settings.author != blank -%}
                  <cite class="review-card__author">{{ block.settings.author }}</cite>
                {%- endif -%}
                {%- if block.settings.detail != blank -%}
                  <span class="review-card__detail">{{ block.settings.detail }}</span>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>

      {%- else -%}
        {%- comment -%} Editor-only guidance; never shown to shoppers. {%- endcomment -%}
        <p class="section-placeholder">
          Add a review app block, or add quotes from real customers, to show this section.
          It stays hidden on your live store until then.
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Customer reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Worn. Loved. Repeated."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Supporting text"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Customer quote",
      "settings": [
        {
          "type": "paragraph",
          "content": "Publish a customer's own words only, with their permission. Do not write sample reviews."
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "info": "For example the product bought, or the city."
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Customer reviews"
    }
  ]
}
{% endschema %}
