{%- doc -%}
  Full-bleed editorial hero slider. Each block is one slide with its own
  image, headline, subtext and call to action.
{%- enddoc -%}

{%- if section.blocks.size > 0 -%}
  <section
    class="hero-slider"
    data-hero-slider
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.interval | times: 1000 }}"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.heading | default: 'Featured collections' }}"
  >
    <div class="hero-slider__track">
      {%- for block in section.blocks -%}
        <div
          class="hero-slider__slide{% if forloop.first %} is-active{% endif %}"
          data-hero-slide
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} of {{ forloop.length }}"
          {% unless forloop.first %}aria-hidden="true"{% endunless %}
          {{ block.shopify_attributes }}
        >
          <div class="hero-slider__media">
            {%- if block.settings.image != blank -%}
              <img
                class="hero-slider__image hero-slider__image--desktop"
                src="{{ block.settings.image | image_url: width: 2000 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 1200 }} 1200w,
                  {{ block.settings.image | image_url: width: 1600 }} 1600w,
                  {{ block.settings.image | image_url: width: 2000 }} 2000w,
                  {{ block.settings.image | image_url: width: 2600 }} 2600w
                "
                sizes="100vw"
                alt="{{ block.settings.image_alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                {% if forloop.first %}
                  loading="eager"
                  fetchpriority="high"
                {% else %}
                  loading="lazy"
                {% endif %}
              >
            {%- else -%}
              <div class="hero-slider__placeholder"></div>
            {%- endif -%}

            {%- if block.settings.image_mobile != blank -%}
              <img
                class="hero-slider__image hero-slider__image--mobile"
                src="{{ block.settings.image_mobile | image_url: width: 1200 }}"
                srcset="
                  {{ block.settings.image_mobile | image_url: width: 750 }} 750w,
                  {{ block.settings.image_mobile | image_url: width: 1000 }} 1000w,
                  {{ block.settings.image_mobile | image_url: width: 1200 }} 1200w
                "
                sizes="100vw"
                alt="{{ block.settings.image_alt | escape }}"
                width="{{ block.settings.image_mobile.width }}"
                height="{{ block.settings.image_mobile.height }}"
                {% if forloop.first %}
                  loading="eager"
                {% else %}
                  loading="lazy"
                {% endif %}
              >
            {%- endif -%}
          </div>

          <div class="hero-slider__scrim" aria-hidden="true"></div>

          <div class="hero-slider__content container">
            <div class="hero-slider__text">
              {%- if block.settings.eyebrow != blank -%}
                <p class="hero-slider__eyebrow">{{ block.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                {%- comment -%}
                  The first slide carries the page's H1; the rest are H2 so
                  the heading order stays valid as slides rotate.
                {%- endcomment -%}
                {%- if forloop.first -%}
                  <h1 class="hero-slider__heading">{{ block.settings.heading | newline_to_br }}</h1>
                {%- else -%}
                  <h2 class="hero-slider__heading">{{ block.settings.heading | newline_to_br }}</h2>
                {%- endif -%}
              {%- endif -%}
              {%- if block.settings.subtext != blank -%}
                <p class="hero-slider__subtext">{{ block.settings.subtext }}</p>
              {%- endif -%}

              {%- if block.settings.button_label != blank or block.settings.button_label_2 != blank -%}
                <div class="hero-slider__actions">
                  {%- if block.settings.button_label != blank -%}
                    <a href="{{ block.settings.button_link | default: routes.all_products_collection_url }}" class="button button--hero">
                      {{ block.settings.button_label }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.button_label_2 != blank -%}
                    <a href="{{ block.settings.button_link_2 | default: routes.all_products_collection_url }}" class="button button--hero-ghost">
                      {{ block.settings.button_label_2 }}
                    </a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <button type="button" class="hero-slider__arrow hero-slider__arrow--prev" data-hero-prev aria-label="Previous slide">
        {%- render 'icon-arrow-left' -%}
      </button>
      <button type="button" class="hero-slider__arrow hero-slider__arrow--next" data-hero-next aria-label="Next slide">
        {%- render 'icon-arrow-right' -%}
      </button>

      <div class="hero-slider__dots" role="tablist" aria-label="Slides">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="hero-slider__dot{% if forloop.first %} is-active{% endif %}"
            data-hero-dot
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="Go to slide {{ forloop.index }}"
          ></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Hero slider",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Slide duration",
      "min": 4,
      "max": 12,
      "step": 1,
      "unit": "s",
      "default": 6
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (desktop)"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image (mobile)",
          "info": "Optional. Falls back to the desktop image."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "NEXOIRA"
        },
        {
          "type": "textarea",
          "id": "heading",
          "label": "Heading",
          "info": "Use a new line for a two-line headline."
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Secondary button label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Secondary button link"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image description",
          "info": "Describes the photo for screen readers. Leave blank if the image is purely decorative."
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "slide",
        "settings": {
          "image": "shopify://shop_images/SHTHMPBGWZYTVW9Z_1781343043969_1gn1mf83smtbbw4.jpg",
          "heading": "EVERYDAY,\nELEVATED.",
          "subtext": "Effortless shirts designed for comfort, versatility and everyday style.",
          "button_label": "SHOP SHIRTS",
          "button_link": "/collections/shirts"
        }
      },
      {
        "type": "slide",
        "settings": {
          "image": "shopify://shop_images/TROHZ6KZZMCKDSQP_1781343038900_0zkt2tmrtm4r5u0.jpg",
          "heading": "MOVE WITH\nCOMFORT.",
          "subtext": "Modern linen-blend trousers designed for effortless movement and refined everyday dressing.",
          "button_label": "SHOP TROUSERS",
          "button_link": "/collections/pants"
        }
      },
      {
        "type": "slide",
        "settings": {
          "image": "shopify://shop_images/KTAHKYVS7GEEZXXX_1781343000222_kvesira8nu6p0ch.jpg",
          "heading": "TRADITION,\nREDEFINED.",
          "subtext": "Contemporary kurtas crafted for celebrations, gatherings and modern Indian style.",
          "button_label": "SHOP KURTAS",
          "button_link": "/collections/kurtas"
        }
      }
    ]
  }
}
{% endschema %}
