<div class="error-page container" data-section-id="{{ section.id }}" data-section-type="main-404">
  <p class="error-page__code">404</p>
  <h1>{{ section.settings.heading }}</h1>
  <p class="error-page__text">{{ section.settings.text }}</p>
  <a href="{{ routes.root_url }}" class="button button--solid">{{ section.settings.button_label }}</a>

  {%- if section.settings.show_shop_links -%}
    <div class="error-page__links">
      <a href="/collections/shirts">Shirts</a>
      <a href="/collections/pants">Trousers</a>
      <a href="/collections/kurta">Kurtas</a>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "This page took a wrong turn."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "The page you're looking for doesn't exist, but your next favorite piece might."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "BACK TO HOMEPAGE"
    },
    {
      "type": "checkbox",
      "id": "show_shop_links",
      "label": "Show quick shop links",
      "default": true
    }
  ]
}
{% endschema %}
