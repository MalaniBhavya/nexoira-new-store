<div class="product" data-section-id="{{ section.id }}" data-section-type="main-product">
  <div class="container product__inner">

    <div class="product__media">
      {%- if product.featured_media -%}
        <div class="product__media-main">
          <img
            src="{{ product.featured_media.preview_image | image_url: width: 1200 }}"
            srcset="
              {{ product.featured_media.preview_image | image_url: width: 600 }} 600w,
              {{ product.featured_media.preview_image | image_url: width: 900 }} 900w,
              {{ product.featured_media.preview_image | image_url: width: 1200 }} 1200w,
              {{ product.featured_media.preview_image | image_url: width: 1600 }} 1600w
            "
            sizes="(min-width: 750px) 50vw, 100vw"
            alt="{{ product.featured_media.alt | escape }}"
            width="{{ product.featured_media.preview_image.width }}"
            height="{{ product.featured_media.preview_image.height }}"
            loading="eager"
          >
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product__media-thumbnails">
            {%- for media in product.media -%}
              <button type="button" class="product__media-thumb" data-media-id="{{ media.id }}">
                <img
                  src="{{ media.preview_image | image_url: width: 200 }}"
                  alt="{{ media.alt | escape }}"
                  width="100"
                  height="100"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="product__media-placeholder"></div>
      {%- endif -%}
    </div>

    <div class="product__info">
      <h1 class="product__title">{{ product.title }}</h1>

      <div class="product__price" data-product-price>
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          <span class="product__price--sale">{{ product.selected_or_first_available_variant.price | money }}</span>
          <span class="product__price--compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
        {%- else -%}
          <span>{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- endif -%}
      </div>

      {%- form 'product', product, id: 'ProductForm', class: 'product__form' -%}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" id="ProductSelectedVariant">

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="product__option">
              <label for="Option-{{ option.position }}">{{ option.name }}</label>
              <select id="Option-{{ option.position }}" class="product__option-select" data-option-position="{{ option.position }}">
                {%- for value in option.values -%}
                  <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endfor -%}
          <script type="application/json" data-product-variants>
            {{ product.variants | json }}
          </script>
        {%- endunless -%}

        <div class="product__quantity">
          <label for="Quantity">{{ 'products.product.quantity.label' | t }}</label>
          <input type="number" id="Quantity" name="quantity" value="1" min="1">
        </div>

        <button
          type="submit"
          name="add"
          class="product__add-to-cart"
          data-label-available="{{ 'products.product.add_to_cart' | t }}"
          data-label-sold-out="{{ 'products.product.sold_out' | t }}"
          {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
        >
          {%- if product.selected_or_first_available_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      {%- endform -%}

      {%- if product.description != blank -%}
        <div class="product__description">
          {{ product.description }}
        </div>
      {%- endif -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Product information",
  "settings": [

  ]
}
{% endschema %}
