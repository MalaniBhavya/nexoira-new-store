{%- doc -%}
  Contact page.

  Uses Shopify's native contact form, which delivers to the store's
  customer email — no app needed. Every contact detail shown alongside it
  comes from theme settings, so nothing here needs editing in code.
{%- enddoc -%}

{%- liquid
  assign wa_number = settings.whatsapp_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
-%}

<div class="contact-page" data-section-id="{{ section.id }}" data-section-type="contact">
  <div class="container">
    {%- render 'breadcrumbs' -%}
  </div>

  <div class="container contact-page__inner">

    <div class="contact-page__intro">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 class="contact-page__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.subtext != blank -%}
        <p class="contact-page__subtext">{{ section.settings.subtext }}</p>
      {%- endif -%}

      <div class="contact-page__details">
        {%- if settings.contact_email != blank -%}
          <div class="contact-page__detail">
            <span class="contact-page__detail-label">Email</span>
            <a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a>
          </div>
        {%- endif -%}

        {%- if settings.contact_phone != blank -%}
          <div class="contact-page__detail">
            <span class="contact-page__detail-label">Phone</span>
            <a href="tel:{{ settings.contact_phone | remove: ' ' }}">{{ settings.contact_phone }}</a>
          </div>
        {%- endif -%}

        {%- if wa_number != blank -%}
          <div class="contact-page__detail">
            <span class="contact-page__detail-label">WhatsApp</span>
            <a
              href="https://wa.me/{{ wa_number }}{% if settings.whatsapp_message != blank %}?text={{ settings.whatsapp_message | url_encode }}{% endif %}"
              rel="noopener"
            >{{ 'general.contact.whatsapp' | t }}</a>
          </div>
        {%- endif -%}

        {%- if settings.social_instagram_link != blank -%}
          <div class="contact-page__detail">
            <span class="contact-page__detail-label">Instagram</span>
            <a href="{{ settings.social_instagram_link }}" rel="noopener">
              {{ settings.social_instagram_handle | default: 'Instagram' }}
            </a>
          </div>
        {%- endif -%}

        {%- if settings.contact_hours != blank -%}
          <div class="contact-page__detail">
            <span class="contact-page__detail-label">Hours</span>
            <span>{{ settings.contact_hours }}</span>
          </div>
        {%- endif -%}

        {%- if section.settings.faq_link != blank -%}
          <div class="contact-page__detail">
            <a href="{{ section.settings.faq_link }}" class="contact-page__faq-link">
              Read our FAQs
              {%- render 'icon-arrow-right' -%}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="contact-page__form">
      {%- form 'contact' -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" tabindex="-1">
            Thanks — we've got your message and will get back to you.
          </p>
        {%- elsif form.errors -%}
          <p class="form-status form-status--error" tabindex="-1">{{ form.errors | default_errors }}</p>
        {%- endif -%}

        <div class="form-field">
          <label for="ContactName">Name</label>
          <input type="text" id="ContactName" name="contact[name]" autocomplete="name" required>
        </div>

        <div class="form-field">
          <label for="ContactEmail">Email</label>
          <input
            type="email"
            id="ContactEmail"
            name="contact[email]"
            autocomplete="email"
            value="{% if customer %}{{ customer.email }}{% endif %}"
            required
          >
        </div>

        <div class="form-field">
          <label for="ContactPhone">Phone <span class="form-field__optional">(optional)</span></label>
          <input type="tel" id="ContactPhone" name="contact[phone]" autocomplete="tel">
        </div>

        <div class="form-field">
          <label for="ContactOrder">Order number <span class="form-field__optional">(optional)</span></label>
          <input type="text" id="ContactOrder" name="contact[Order number]" inputmode="numeric">
        </div>

        <div class="form-field">
          <label for="ContactReason">Reason</label>
          <div class="form-field__select">
            <select id="ContactReason" name="contact[Reason]">
              {%- assign reasons = section.settings.reasons | split: ',' -%}
              {%- for reason in reasons -%}
                <option value="{{ reason | strip | escape }}">{{ reason | strip }}</option>
              {%- endfor -%}
            </select>
            {%- render 'icon-chevron-down' -%}
          </div>
        </div>

        <div class="form-field">
          <label for="ContactMessage">Message</label>
          <textarea id="ContactMessage" name="contact[body]" rows="6" required></textarea>
        </div>

        <button type="submit" class="button button--solid">Send message</button>
      {%- endform -%}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "paragraph",
      "content": "Email, phone, WhatsApp, Instagram and support hours come from Theme settings → Contact. Blank fields are hidden."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "GET IN TOUCH"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We're here to help."
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Supporting text",
      "default": "Questions about an order, sizing or anything else — write in and a real person will get back to you."
    },
    {
      "type": "text",
      "id": "reasons",
      "label": "Reasons (comma separated)",
      "default": "Order status, Returns or exchange, Sizing help, Payment issue, Product question, Something else"
    },
    {
      "type": "url",
      "id": "faq_link",
      "label": "FAQ page link"
    }
  ]
}
{% endschema %}
