{%- comment -%}
  Equal-weight editorial card grid. Reused via presets for "Shop by
  Category" (Shirts/Kurtas/Pants, equal strategic importance per PRD §5)
  and "Shop by Occasion" (Casual/Smart Casual/Traditional) rather than
  two near-identical sections. Each card is a block, so the merchant
  controls count/order/content directly in Theme Editor.
{%- endcomment -%}

{%- if section.blocks.size > 0 -%}
  <section class="editorial-cards container">
    {%- if section.settings.heading != blank -%}
      <h2 class="editorial-cards__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="editorial-cards__grid" style="--card-count: {{ section.blocks.size }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign card_url = block.settings.url
          if card_url == blank
            case block.settings.heading
              when 'Shirts'
                assign card_url = settings.shirts_url
              when 'Kurtas'
                assign card_url = settings.kurtas_url
              when 'Pants'
                assign card_url = settings.pants_url
              when 'Casual'
                assign card_url = settings.occasion_casual_url
              when 'Smart Casual'
                assign card_url = settings.occasion_smart_casual_url
              when 'Traditional'
                assign card_url = settings.occasion_traditional_url
            endcase
          endif
        -%}
        <a href="{{ card_url }}" class="editorial-card" {{ block.shopify_attributes }}>
          <span class="editorial-card__media aspect-portrait">
            {%- if block.settings.image -%}
              <img
                src="{{ block.settings.image | image_url: width: 600 }}"
                srcset="
                  {{- block.settings.image | image_url: width: 400 }} 400w,
                  {{ block.settings.image | image_url: width: 600 }} 600w,
                  {{ block.settings.image | image_url: width: 800 }} 800w
                "
                sizes="(min-width: 990px) 30vw, 45vw"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                alt="{{ block.settings.image.alt | default: block.settings.heading | escape }}"
                loading="lazy"
              >
            {%- else -%}
              <span class="editorial-card__media-placeholder"></span>
            {%- endif -%}
          </span>
          <span class="editorial-card__heading">{{ block.settings.heading }}</span>
          {%- if block.settings.subtext != blank -%}
            <span class="editorial-card__subtext">{{ block.settings.subtext }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .editorial-cards {
    padding-block: var(--section-spacing-y);
  }

  .editorial-cards__heading {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .editorial-cards__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
  }

  @media (min-width: 750px) {
    .editorial-cards__grid {
      grid-template-columns: repeat(var(--card-count, 3), 1fr);
    }
  }

  .editorial-card {
    text-decoration: none;
    color: var(--color-ink);
    display: flex;
    flex-direction: column;
  }

  .editorial-card__media {
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-surface-alt);
    margin-bottom: var(--space-3);
  }

  .editorial-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--duration-base) var(--ease-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    .editorial-card:hover .editorial-card__media img {
      transform: scale(1.04);
    }
  }

  .editorial-card__media-placeholder {
    display: block;
    width: 100%;
    height: 100%;
  }

  .editorial-card__heading {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-heading);
  }

  .editorial-card__subtext {
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin-top: var(--space-1);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Editorial cards",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Category"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by Category",
      "settings": {
        "heading": "Shop by Category"
      },
      "blocks": [
        { "type": "card", "settings": { "heading": "Shirts" } },
        { "type": "card", "settings": { "heading": "Kurtas" } },
        { "type": "card", "settings": { "heading": "Pants" } }
      ]
    },
    {
      "name": "Shop by Occasion",
      "settings": {
        "heading": "Shop by Occasion"
      },
      "blocks": [
        { "type": "card", "settings": { "heading": "Casual" } },
        { "type": "card", "settings": { "heading": "Smart Casual" } },
        { "type": "card", "settings": { "heading": "Traditional" } }
      ]
    }
  ]
}
{% endschema %}
