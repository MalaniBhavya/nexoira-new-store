{%- liquid
  assign password_heading = section.settings.heading
  if password_heading == blank
    assign password_heading = 'general.password_page.heading' | t
  endif
-%}
<div class="password-page container">
  <div class="password-page__inner">
    {%- if settings.logo -%}
      <div class="password-page__logo">
        {{ settings.logo | image_url: width: 200 | image_tag: loading: 'eager', widths: '140,200' }}
      </div>
    {%- else -%}
      <p class="password-page__wordmark">{{ shop.name }}</p>
    {%- endif -%}

    <h1 class="password-page__heading">{{ password_heading }}</h1>
    {%- if section.settings.body != blank -%}
      <div class="password-page__body rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'password-page__form' -%}
      {%- if form.errors -%}
        <p class="field__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label class="visually-hidden" for="PasswordPagePassword">{{ 'general.password_page.password_label' | t }}</label>
        <div class="password-page__form-row">
          <input type="password" id="PasswordPagePassword" name="password" class="input" placeholder="{{ 'general.password_page.password_label' | t }}">
          <button type="submit" class="button--primary">{{ 'general.password_page.enter' | t }}</button>
        </div>
      </div>
    {%- endform -%}

    {%- if settings.social_instagram != blank or settings.social_facebook != blank -%}
      <div class="password-page__social">
        {%- if settings.social_instagram != blank -%}
          <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" class="button--icon">
            {%- render 'icon', name: 'instagram', size: 18, title: 'Instagram' -%}
          </a>
        {%- endif -%}
        {%- if settings.social_facebook != blank -%}
          <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" class="button--icon">
            {%- render 'icon', name: 'facebook', size: 18, title: 'Facebook' -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .password-page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .password-page__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    max-width: 480px;
  }

  .password-page__logo img {
    width: 140px;
    height: auto;
  }

  .password-page__wordmark {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-heading);
  }

  .password-page__heading {
    font-size: var(--text-3xl);
  }

  .password-page__body {
    color: var(--color-ink-muted);
  }

  .password-page__form-row {
    display: flex;
    gap: var(--space-2);
  }

  .password-page__social {
    display: flex;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .password-page__admin-link {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body text"
    }
  ]
}
{% endschema %}
