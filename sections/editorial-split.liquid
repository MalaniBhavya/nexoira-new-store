{%- comment -%}
  Half-image, half-text editorial section. Image side is configurable
  left or right for layout variety across the page.
{%- endcomment -%}

<section
  class="editorial-split{% if section.settings.image_position == 'right' %} editorial-split--image-right{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="editorial-split"
>
  <div class="editorial-split__media" data-reveal="image">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 1400 }}"
        srcset="
          {{ section.settings.image | image_url: width: 700 }} 700w,
          {{ section.settings.image | image_url: width: 1000 }} 1000w,
          {{ section.settings.image | image_url: width: 1400 }} 1400w,
          {{ section.settings.image | image_url: width: 1800 }} 1800w
        "
        sizes="(min-width: 750px) 50vw, 100vw"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="editorial-split__placeholder"></div>
    {%- endif -%}
  </div>

  <div class="editorial-split__content">
    <div class="editorial-split__text" data-reveal>
      {%- if section.settings.heading != blank -%}
        <h2 class="editorial-split__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="editorial-split__body">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: '#' }}" class="button button--outline">
          {{ section.settings.button_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Editorial split",
  "settings": [
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "DESIGNED FOR REAL LIFE."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Good clothing should not require a special occasion.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "DISCOVER NEXOIRA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Editorial split"
    }
  ]
}
{% endschema %}
