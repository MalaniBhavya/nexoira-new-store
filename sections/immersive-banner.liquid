{%- comment -%}
  Full-bleed immersive image banner with centered overlay text.
  Used for the Kurta editorial moment, but works for any large
  lifestyle statement.
{%- endcomment -%}

<section
  class="immersive-banner{% if section.settings.text_color == 'light' %} immersive-banner--light{% endif %} immersive-banner--tint-{{ section.settings.tint | default: 'none' }}"
  data-section-id="{{ section.id }}"
  data-section-type="immersive-banner"
>
  <div class="immersive-banner__media" data-reveal="image">
    {%- if section.settings.image != blank -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 1000 }} 1000w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w,
          {{ section.settings.image | image_url: width: 2600 }} 2600w
        "
        sizes="100vw"
        alt="{{ section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="lazy"
      >
    {%- else -%}
      <div class="immersive-banner__placeholder"></div>
    {%- endif -%}
    <div class="immersive-banner__scrim" aria-hidden="true"></div>
  </div>

  <div class="immersive-banner__content container" data-reveal>
    {%- if section.settings.heading != blank -%}
      <h2 class="immersive-banner__heading">{{ section.settings.heading | newline_to_br }}</h2>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="button button--hero">
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Immersive banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "Text color",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "tint",
      "label": "Overlay tint",
      "options": [
        {
          "value": "none",
          "label": "Neutral"
        },
        {
          "value": "earth",
          "label": "Earth"
        },
        {
          "value": "accent",
          "label": "Accent"
        }
      ],
      "default": "none"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "ROOTED IN TRADITION.\nMADE FOR TODAY."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "EXPLORE KURTAS"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Immersive banner"
    }
  ]
}
{% endschema %}
