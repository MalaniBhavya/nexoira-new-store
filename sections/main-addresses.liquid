<div class="customer-addresses container" data-section-id="{{ section.id }}" data-section-type="main-addresses">
  <div class="account-header">
    <div>
      <p class="about-story__eyebrow">MY ACCOUNT</p>
      <h1>Addresses</h1>
    </div>
    <div class="account-header__actions">
      <a href="{{ routes.account_url }}" class="button button--outline">Back to account</a>
    </div>
  </div>

  {%- if customer.addresses.size > 0 -%}
    <div class="customer-addresses__grid">
      {%- for address in customer.addresses -%}
        <div class="address-card">
          {%- if address == customer.default_address -%}
            <span class="badge">Default</span>
          {%- endif -%}
          <p>{{ address | format_address }}</p>
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="customer-account__empty">You don't have any saved addresses yet.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Customer addresses",
  "settings": [

  ]
}
{% endschema %}
