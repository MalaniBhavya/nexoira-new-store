{%- comment -%}
  Instagram / styling gallery.

  Deliberately not an Instagram API integration: the Basic Display API
  needs server-side token refresh that a theme cannot do, so a hard-coded
  feed would break within weeks. Instead this renders merchant-curated
  images that always work, and accepts an app block so an installed feed
  app can take the section over. See DEPLOYMENT.md.
{%- endcomment -%}

{%- liquid
  assign profile_url = section.settings.handle_link | default: settings.social_instagram_link
  assign handle_text = section.settings.handle | default: settings.social_instagram_handle

  assign app_blocks = 0
  for block in section.blocks
    if block.type == '@app'
      assign app_blocks = app_blocks | plus: 1
    endif
  endfor
-%}

<section class="instagram-section" data-section-id="{{ section.id }}" data-section-type="instagram">
  <div class="container">
    <div class="section-heading section-heading--center" data-reveal>
      <div class="section-heading__text">
        {%- if section.settings.heading != blank -%}
          <h2 class="section-heading__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="section-heading__subtitle">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- if handle_text != blank and profile_url != blank -%}
        <a href="{{ profile_url }}" class="instagram-section__handle" rel="noopener">
          {%- render 'icon-instagram' -%}
          <span>{{ handle_text }}</span>
        </a>
      {%- endif -%}
    </div>

    {%- if app_blocks > 0 -%}
      {%- comment -%} A feed app is installed — let it own the grid. {%- endcomment -%}
      <div class="instagram-section__app">
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}
            {%- render block -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="instagram-section__grid">
        {%- for block in section.blocks -%}
          {%- if block.type != 'image' -%}{%- continue -%}{%- endif -%}
          {%- assign reveal_delay = forloop.index0 | at_most: 5 | times: 90 -%}

          {%- capture item_media -%}
            {%- if block.settings.image != blank -%}
              <img
                src="{{ block.settings.image | image_url: width: 800 }}"
                srcset="
                  {{ block.settings.image | image_url: width: 400 }} 400w,
                  {{ block.settings.image | image_url: width: 600 }} 600w,
                  {{ block.settings.image | image_url: width: 800 }} 800w
                "
                sizes="(min-width: 990px) 16vw, (min-width: 750px) 25vw, 45vw"
                alt="{{ block.settings.image.alt | escape }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="instagram-section__placeholder"></div>
            {%- endif -%}
          {%- endcapture -%}

          {%- if block.settings.link != blank -%}
            <a
              class="instagram-section__item"
              href="{{ block.settings.link }}"
              data-reveal
              style="--reveal-delay: {{ reveal_delay }}ms;"
              {{ block.shopify_attributes }}
            >{{ item_media }}</a>
          {%- else -%}
            <div
              class="instagram-section__item"
              data-reveal
              style="--reveal-delay: {{ reveal_delay }}ms;"
              {{ block.shopify_attributes }}
            >{{ item_media }}</div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Instagram",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@NEXOIRA"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Supporting text",
      "default": "Tag us to be featured."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Handle text",
      "info": "Defaults to the handle set in Theme settings → Social media."
    },
    {
      "type": "url",
      "id": "handle_link",
      "label": "Profile link",
      "info": "Defaults to the Instagram URL in Theme settings."
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Set the alt text on the image in Content → Files so screen readers describe it."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Instagram",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
