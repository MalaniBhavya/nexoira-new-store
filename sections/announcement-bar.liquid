{%- liquid
  assign message_count = section.blocks.size
-%}

{%- if message_count > 0 -%}
  <div
    class="announcement-bar"
    id="AnnouncementBar-{{ section.id }}"
    data-announcement-bar
    data-autoplay="{{ section.settings.autorotate }}"
    {% if message_count == 1 %}data-single{% endif %}
  >
    <div class="container announcement-bar__inner">
      <div class="announcement-bar__track" role="{% if message_count > 1 %}group{% endif %}" aria-live="off">
        {%- for block in section.blocks -%}
          <div
            class="announcement-bar__slide"
            id="AnnouncementSlide-{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link -%}
              <a href="{{ block.settings.link }}" class="announcement-bar__link">{{ block.settings.text | escape }}</a>
            {%- else -%}
              <p class="announcement-bar__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

      {%- if message_count > 1 -%}
        <div class="announcement-bar__controls">
          <button type="button" class="button--icon announcement-bar__prev" data-announcement-prev>
            {%- render 'icon', name: 'chevron-left', size: 16, title: 'general.accessibility.previous' | t -%}
          </button>
          <button type="button" class="button--icon announcement-bar__next" data-announcement-next>
            {%- render 'icon', name: 'chevron-right', size: 16, title: 'general.accessibility.next' | t -%}
          </button>
        </div>
      {%- endif -%}

      {%- if section.settings.show_close -%}
        <button type="button" class="button--icon announcement-bar__close" data-announcement-close>
          {%- render 'icon', name: 'close', size: 16, title: 'general.accessibility.close' | t -%}
        </button>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .announcement-bar {
    background: var(--color-ink);
    color: var(--color-surface);
  }

  .announcement-bar__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding-block: var(--space-2);
    padding-inline-end: var(--space-9);
    gap: var(--space-2);
  }

  .announcement-bar__track {
    flex: 1;
    text-align: center;
    overflow: hidden;
  }

  .announcement-bar__slide {
    font-size: var(--text-xs);
    letter-spacing: 0.02em;
  }

  .announcement-bar__link {
    text-decoration: none;
  }

  .announcement-bar__link:hover {
    text-decoration: underline;
  }

  .announcement-bar__controls {
    display: flex;
    gap: var(--space-1);
  }

  .announcement-bar__controls .icon,
  .announcement-bar__close .icon {
    color: var(--color-surface);
    width: 1rem;
    height: 1rem;
  }

  .announcement-bar__controls .button--icon,
  .announcement-bar__close.button--icon {
    min-width: 32px;
    min-height: 32px;
  }

  .announcement-bar__controls .button--icon:hover,
  .announcement-bar__close.button--icon:hover {
    background: rgba(255, 255, 255, 0.12);
  }

  .announcement-bar__close {
    position: absolute;
    right: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
  }
{% endstylesheet %}

{% javascript %}
  (function () {
    function initAnnouncementBar(root) {
      if (root.hasAttribute('data-single')) return;

      var slides = Array.prototype.slice.call(root.querySelectorAll('.announcement-bar__slide'));
      var index = 0;
      var timer = null;
      var delay = (parseInt(root.getAttribute('data-autoplay'), 10) || 0) * 1000;
      var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function show(nextIndex) {
        slides[index].hidden = true;
        index = (nextIndex + slides.length) % slides.length;
        slides[index].hidden = false;
      }

      function next() { show(index + 1); }
      function prev() { show(index - 1); }

      function play() {
        if (!delay || reduceMotion) return;
        stop();
        timer = window.setInterval(next, delay);
      }

      function stop() {
        if (timer) window.clearInterval(timer);
        timer = null;
      }

      var nextBtn = root.querySelector('[data-announcement-next]');
      var prevBtn = root.querySelector('[data-announcement-prev]');
      if (nextBtn) nextBtn.addEventListener('click', function () { next(); play(); });
      if (prevBtn) prevBtn.addEventListener('click', function () { prev(); play(); });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', play);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', play);

      play();
    }

    function initDismiss(root) {
      var closeBtn = root.querySelector('[data-announcement-close]');
      if (!closeBtn) return;

      var dismissKey = 'nexoira:announcement-dismissed:' + root.id;
      try {
        if (window.sessionStorage.getItem(dismissKey)) {
          root.hidden = true;
        }
      } catch (e) {}

      closeBtn.addEventListener('click', function () {
        root.hidden = true;
        try {
          window.sessionStorage.setItem(dismissKey, '1');
        } catch (e) {}
      });
    }

    document.querySelectorAll('[data-announcement-bar]').forEach(function (root) {
      initAnnouncementBar(root);
      initDismiss(root);
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "range",
      "id": "autorotate",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Rotate messages every",
      "info": "0 disables auto-rotation",
      "default": 5
    },
    {
      "type": "checkbox",
      "id": "show_close",
      "label": "Allow customers to dismiss",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "Free shipping on orders above ₹999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Optional"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message" }
      ]
    }
  ]
}
{% endschema %}
