<!-- Renders globally, above the header, in layout/theme.liquid -->
{%- if section.blocks.size > 0 -%}
  <div
    class="announcement-bar"
    data-announcement-bar
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.interval | times: 1000 }}"
    role="region"
    aria-label="Announcements"
  >
    <div class="announcement-bar__track">
      {%- for block in section.blocks -%}
        <p
          class="announcement-bar__message{% if forloop.first %} is-active{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}">{{ block.settings.text }}</a>
          {%- else -%}
            {{ block.settings.text }}
          {%- endif -%}
        </p>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Rotate messages automatically",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "label": "Rotation speed",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Message",
          "default": "FREE SHIPPING ON ORDERS ABOVE ₹999"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "message",
        "settings": {
          "text": "FREE SHIPPING ON ORDERS ABOVE ₹999"
        }
      },
      {
        "type": "message",
        "settings": {
          "text": "PREMIUM STYLE. HONEST PRICING."
        }
      },
      {
        "type": "message",
        "settings": {
          "text": "THE NEW FACE OF TRADITION"
        }
      }
    ]
  }
}
{% endschema %}
