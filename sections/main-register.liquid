<div class="customer-register container" data-section-id="{{ section.id }}" data-section-type="main-register">
  <div class="auth-card">
    <div class="section-heading section-heading--center">
      <h1 class="section-heading__title">Create Account</h1>
    </div>

    {%- form 'create_customer' -%}
      {%- if form.errors -%}
        <p class="form-status form-status--error">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <label for="RegisterFirstName">First name</label>
      <input type="text" name="customer[first_name]" id="RegisterFirstName" autocomplete="given-name">

      <label for="RegisterLastName">Last name</label>
      <input type="text" name="customer[last_name]" id="RegisterLastName" autocomplete="family-name">

      <label for="RegisterEmail">Email</label>
      <input type="email" name="customer[email]" id="RegisterEmail" autocomplete="email" required>

      <label for="RegisterPassword">Password</label>
      <input type="password" name="customer[password]" id="RegisterPassword" autocomplete="new-password">

      <button type="submit" class="button button--solid">Create account</button>

      <div class="auth-card__links">
        <a href="{{ routes.account_login_url }}">Already have an account? Sign in</a>
      </div>
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer register",
  "settings": [

  ]
}
{% endschema %}
