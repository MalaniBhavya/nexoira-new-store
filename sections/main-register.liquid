<div class="account-page container">
  <div class="account-form-wrap">
    <h1 class="account-page__heading">{{ 'general.customer.create_account' | t }}</h1>
    {%- form 'create_customer', class: 'account-form' -%}
      {%- if form.errors -%}
        <p class="field__error">{{ form.errors | default_errors }}</p>
      {%- endif -%}
      <div class="field">
        <label class="field__label" for="RegisterFirstName">{{ 'general.customer.first_name' | t }}</label>
        <input type="text" id="RegisterFirstName" name="customer[first_name]" class="input" autocomplete="given-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterLastName">{{ 'general.customer.last_name' | t }}</label>
        <input type="text" id="RegisterLastName" name="customer[last_name]" class="input" autocomplete="family-name">
      </div>
      <div class="field">
        <label class="field__label" for="RegisterEmail">{{ 'general.customer.email' | t }}</label>
        <input type="email" id="RegisterEmail" name="customer[email]" class="input" autocomplete="email" required>
      </div>
      <div class="field">
        <label class="field__label" for="RegisterPassword">{{ 'general.customer.password' | t }}</label>
        <input type="password" id="RegisterPassword" name="customer[password]" class="input" autocomplete="new-password" required>
      </div>
      <button type="submit" class="button--primary button--full">{{ 'general.customer.create_account' | t }}</button>
    {%- endform -%}

    <p class="account-page__alt">
      <a href="{{ routes.account_login_url }}">{{ 'general.customer.sign_in' | t }}</a>
    </p>
  </div>
</div>

{% stylesheet %}
  .account-page {
    padding-block: var(--space-8) var(--section-spacing-y);
    display: flex;
    justify-content: center;
  }

  .account-form-wrap {
    width: 100%;
    max-width: 400px;
  }

  .account-page__heading {
    font-size: var(--text-2xl);
    margin-bottom: var(--space-5);
    text-align: center;
  }

  .account-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .account-page__alt {
    text-align: center;
    margin-top: var(--space-5);
    font-size: var(--text-sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Register page"
}
{% endschema %}
