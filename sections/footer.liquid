{%- doc -%}
  Site-wide footer. Link columns are built from repeatable blocks
  grouped by column, so every link is editable from the theme
  customizer without requiring a pre-built navigation menu.
{%- enddoc -%}

<footer class="site-footer" data-section-id="{{ section.id }}" data-section-type="footer">
  <div class="container site-footer__inner" data-reveal>

    <div class="site-footer__brand">
      <a href="{{ routes.root_url }}" class="site-footer__logo">Nexoira</a>
      {%- if section.settings.tagline != blank -%}
        <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- if settings.social_instagram_link != blank or settings.social_facebook_link != blank -%}
        <div class="site-footer__social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" aria-label="Instagram">{%- render 'icon-instagram' -%}</a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" aria-label="Facebook">{%- render 'icon-facebook' -%}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="site-footer__column">
      <h3 class="site-footer__heading">Shop</h3>
      <ul class="site-footer__link-list">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'shop' -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="site-footer__column">
      <h3 class="site-footer__heading">About</h3>
      <ul class="site-footer__link-list">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'about' -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

    <div class="site-footer__column">
      <h3 class="site-footer__heading">Customer Care</h3>
      <ul class="site-footer__link-list">
        {%- for block in section.blocks -%}
          {%- if block.settings.column == 'care' -%}
            <li {{ block.shopify_attributes }}><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.title }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>

  </div>

  <div class="container site-footer__bottom">
    {%- if shop.enabled_payment_types.size > 0 -%}
      <div class="site-footer__payment-icons">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_svg_tag: class: 'site-footer__payment-icon' }}
        {%- endfor -%}
      </div>
    {%- endif -%}
    <p class="site-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }} &mdash; {{ 'footer.copyright' | t }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "THE NEW FACE OF TRADITION"
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        {
          "type": "select",
          "id": "column",
          "label": "Column",
          "options": [
            {
              "value": "shop",
              "label": "Shop"
            },
            {
              "value": "about",
              "label": "About"
            },
            {
              "value": "care",
              "label": "Customer Care"
            }
          ],
          "default": "shop"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Link text"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "link",
        "settings": {
          "column": "shop",
          "title": "Shirts",
          "url": "/collections/shirts"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "shop",
          "title": "Trousers",
          "url": "/collections/pants"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "shop",
          "title": "Kurtas",
          "url": "/collections/kurta"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "shop",
          "title": "New Arrivals",
          "url": "/collections/new-arrivals"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "about",
          "title": "Our Story",
          "url": "/pages/about"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "about",
          "title": "Contact",
          "url": "/pages/contact"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "about",
          "title": "Shipping & Returns",
          "url": "/policies/shipping-policy"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "about",
          "title": "Privacy Policy",
          "url": "/policies/privacy-policy"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "about",
          "title": "Refund Policy",
          "url": "/policies/refund-policy"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "about",
          "title": "Terms of Service",
          "url": "/policies/terms-of-service"
        }
      },
      {
        "type": "link",
        "settings": {
          "column": "care",
          "title": "FAQ",
          "url": "/pages/faq"
        }
      }
    ]
  }
}
{% endschema %}
