<footer class="site-footer">
  <div class="container site-footer__top">
    <div class="site-footer__brand">
      <a href="{{ routes.root_url }}" class="site-footer__logo">
        {%- if settings.logo -%}
          {{ settings.logo | image_url: width: 200 | image_tag: loading: 'lazy', widths: '120,160,200' }}
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
      {%- if section.settings.tagline != blank -%}
        <p class="site-footer__tagline">{{ section.settings.tagline }}</p>
      {%- endif -%}

      {%- if settings.social_instagram != blank or settings.social_facebook != blank -%}
        <div class="site-footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" class="button--icon">
              {%- render 'icon', name: 'instagram', size: 18, title: 'Instagram' -%}
            </a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener" class="button--icon">
              {%- render 'icon', name: 'facebook', size: 18, title: 'Facebook' -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="site-footer__column">
      <p class="site-footer__heading">{{ 'general.footer.shop_heading' | t }}</p>
      <ul>
        <li><a href="{{ settings.shirts_url }}">{{ 'general.navigation.shirts' | t }}</a></li>
        <li><a href="{{ settings.kurtas_url }}">{{ 'general.navigation.kurtas' | t }}</a></li>
        <li><a href="{{ settings.pants_url }}">{{ 'general.navigation.pants' | t }}</a></li>
        <li><a href="{{ settings.about_url }}">{{ 'general.navigation.about' | t }}</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">{{ 'general.navigation.all_collections' | t }}</a></li>
      </ul>
    </div>

    <div class="site-footer__column">
      <p class="site-footer__heading">{{ 'general.footer.support_heading' | t }}</p>
      <ul>
        <li><a href="{{ settings.size_guide_url }}">{{ 'general.navigation.size_guide' | t }}</a></li>
        <li><a href="{{ settings.track_order_url }}">{{ 'general.navigation.track_order' | t }}</a></li>
        <li><a href="{{ settings.faq_url }}">{{ 'general.navigation.faq' | t }}</a></li>
        <li><a href="{{ settings.contact_url }}">{{ 'general.navigation.contact_us' | t }}</a></li>
        {%- for policy in shop.policies -%}
          <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
        {%- endfor -%}
      </ul>
    </div>

    <div class="site-footer__column">
      <p class="site-footer__heading">{{ 'general.footer.connect_heading' | t }}</p>
      <ul>
        {%- if settings.contact_email != blank -%}
          <li><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>
        {%- endif -%}
        {%- if settings.contact_phone != blank -%}
          <li><a href="tel:{{ settings.contact_phone }}">{{ settings.contact_phone }}</a></li>
        {%- endif -%}
        {%- if settings.contact_whatsapp != blank -%}
          <li><a href="https://wa.me/{{ settings.contact_whatsapp }}" target="_blank" rel="noopener">{{ 'general.navigation.whatsapp_us' | t }}</a></li>
        {%- endif -%}
      </ul>
    </div>

    {%- if section.settings.show_newsletter -%}
      <div class="site-footer__column site-footer__newsletter">
        <p class="site-footer__heading">{{ 'general.footer.newsletter_heading' | t }}</p>
        {%- form 'customer', id: 'FooterNewsletterForm', class: 'site-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="site-footer__newsletter-success" role="status">{{ 'general.footer.newsletter_success' | t }}</p>
          {%- else -%}
            <div class="field">
              <label for="FooterNewsletterEmail" class="visually-hidden">{{ 'general.footer.newsletter_placeholder' | t }}</label>
              <div class="site-footer__newsletter-row">
                <input
                  type="email"
                  id="FooterNewsletterEmail"
                  name="contact[email]"
                  class="input"
                  placeholder="{{ 'general.footer.newsletter_placeholder' | t }}"
                  required
                  {% if form.errors %}aria-invalid="true"{% endif %}
                >
                <button type="submit" class="button--primary">{{ 'general.footer.newsletter_cta' | t }}</button>
              </div>
              {%- if form.errors -%}
                <p class="field__error">
                  {%- for field in form.errors -%}
                    {{ form.errors.messages[field] }}
                  {%- endfor -%}
                </p>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_trust_bar -%}
    {%- assign free_shipping_amount = settings.free_shipping_threshold | times: 100 | money -%}
    <div class="site-footer__trust">
      <div class="container site-footer__trust-inner">
        <div class="site-footer__trust-item">
          {%- render 'icon', name: 'truck', size: 20 -%}
          <span>{{ 'general.footer.trust_shipping' | t: amount: free_shipping_amount }}</span>
        </div>
        <div class="site-footer__trust-item">
          {%- render 'icon', name: 'return', size: 20 -%}
          <span>{{ 'general.footer.trust_returns' | t: days: settings.returns_window_days }}</span>
        </div>
        {%- if settings.cod_enabled -%}
          <div class="site-footer__trust-item">
            {%- render 'icon', name: 'shield-check', size: 20 -%}
            <span>{{ 'general.footer.trust_cod' | t }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  {%- assign current_year = 'now' | date: '%Y' -%}
  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p>{{ 'general.footer.copyright' | t: year: current_year, shop: shop.name }}</p>
    </div>
  </div>
</footer>

{% stylesheet %}
  .site-footer {
    background: var(--color-surface-alt);
    border-top: 1px solid var(--color-border);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  @media (min-width: 750px) {
    .site-footer__top {
      grid-template-columns: 1.4fr repeat(3, 1fr) 1.4fr;
      gap: var(--space-6);
    }
  }

  .site-footer__logo {
    display: inline-block;
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    font-weight: var(--font-weight-heading);
    text-decoration: none;
    color: var(--color-ink);
  }

  .site-footer__tagline {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    max-width: 32ch;
  }

  .site-footer__social {
    display: flex;
    gap: var(--space-1);
    margin-top: var(--space-3);
  }

  .site-footer__heading {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-ink-muted);
    margin: 0 0 var(--space-3);
  }

  .site-footer__column ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-footer__column a {
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-ink);
  }

  .site-footer__column a:hover {
    color: var(--color-accent-900);
  }

  .site-footer__newsletter-row {
    display: flex;
    gap: var(--space-2);
  }

  .site-footer__newsletter-row .input {
    flex: 1;
  }

  .site-footer__newsletter-success {
    font-size: var(--text-sm);
    color: var(--color-success);
  }

  .site-footer__trust {
    border-top: 1px solid var(--color-border);
  }

  .site-footer__trust-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding-block: var(--space-4);
  }

  .site-footer__trust-item {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .site-footer__trust-item .icon {
    color: var(--color-accent-900);
  }

  .site-footer__bottom {
    border-top: 1px solid var(--color-border);
  }

  .site-footer__bottom-inner {
    padding-block: var(--space-4);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "info": "Optional short line under the logo"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_bar",
      "label": "Show shipping / returns / COD bar",
      "default": true
    }
  ]
}
{% endschema %}
