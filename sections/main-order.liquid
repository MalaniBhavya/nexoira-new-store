<div class="customer-order container" data-section-id="{{ section.id }}" data-section-type="main-order">
  <div class="account-header">
    <div>
      <p class="about-story__eyebrow">ORDER {{ order.name }}</p>
      <h1>Placed on {{ order.created_at | date: '%B %d, %Y' }}</h1>
    </div>
    <div class="account-header__actions">
      <a href="{{ routes.account_url }}" class="button button--outline">Back to account</a>
    </div>
  </div>

  <div class="customer-order-table-wrap">
    <table class="customer-orders">
      <thead>
        <tr>
          <th>Product</th>
          <th>Quantity</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody>
        {%- for line_item in order.line_items -%}
          <tr>
            <td>{{ line_item.title }}</td>
            <td>{{ line_item.quantity }}</td>
            <td>{{ line_item.final_line_price | money }}</td>
          </tr>
        {%- endfor -%}
      </tbody>
    </table>
  </div>

  <p class="customer-order__total">Total: {{ order.total_price | money }}</p>
</div>

{% schema %}
{
  "name": "Customer order",
  "settings": [

  ]
}
{% endschema %}
