<div class="customer-order container">
  <h1>Order {{ order.name }}</h1>
  <p>Placed on {{ order.created_at | date: '%B %d, %Y' }}</p>

  <table class="customer-order__table">
    <thead>
      <tr>
        <th>Product</th>
        <th>Quantity</th>
        <th>Total</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr>
          <td>{{ line_item.title }}</td>
          <td>{{ line_item.quantity }}</td>
          <td>{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
  </table>

  <p class="customer-order__total">Total: {{ order.total_price | money }}</p>
</div>

{% schema %}
{
  "name": "Customer order",
  "settings": [

  ]
}
{% endschema %}
