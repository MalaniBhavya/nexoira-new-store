[
  {
    "name": "theme_info",
    "theme_name": "Nexoira",
    "theme_version": "1.0.0",
    "theme_author": "Nexoira",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 220,
        "step": 5,
        "unit": "px",
        "label": "Logo width (desktop)",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Displayed at 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "paragraph",
        "content": "Brand accent is deliberately restricted to a curated set of tones drawn from the Nexoira logo, to keep the storefront's minimal, sophisticated look consistent."
      },
      {
        "type": "select",
        "id": "accent_color",
        "label": "Brand accent",
        "options": [
          { "value": "#D8A224", "label": "Nexoira Gold (default)" },
          { "value": "#B68921", "label": "Antique Gold" },
          { "value": "#E8C77C", "label": "Champagne" },
          { "value": "#96711E", "label": "Bronze" }
        ],
        "default": "#D8A224"
      },
      {
        "type": "select",
        "id": "surface_style",
        "label": "Background tone",
        "options": [
          { "value": "warm", "label": "Warm ivory (default)" },
          { "value": "pure", "label": "Pure white" }
        ],
        "default": "warm"
      },
      {
        "type": "select",
        "id": "text_contrast",
        "label": "Text contrast",
        "options": [
          { "value": "standard", "label": "Standard (default)" },
          { "value": "soft", "label": "Softer" }
        ],
        "default": "standard"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Nexoira pairs an editorial serif (headings) with a humanist sans-serif (body and UI) for a premium, highly readable feel. Both are self-hosted for performance."
      },
      {
        "type": "select",
        "id": "text_scale",
        "label": "Type scale density",
        "options": [
          { "value": "compact", "label": "Compact" },
          { "value": "default", "label": "Default" },
          { "value": "spacious", "label": "Spacious" }
        ],
        "default": "default"
      },
      {
        "type": "select",
        "id": "heading_weight",
        "label": "Heading weight",
        "options": [
          { "value": "400", "label": "Regular" },
          { "value": "700", "label": "Bold (default)" }
        ],
        "default": "700"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1200,
        "max": 1600,
        "step": 20,
        "unit": "px",
        "label": "Max content width",
        "default": 1400
      },
      {
        "type": "select",
        "id": "section_spacing",
        "label": "Section spacing",
        "options": [
          { "value": "compact", "label": "Compact" },
          { "value": "default", "label": "Default" },
          { "value": "spacious", "label": "Spacious" }
        ],
        "default": "default"
      }
    ]
  },
  {
    "name": "Buttons & inputs",
    "settings": [
      {
        "type": "select",
        "id": "corner_radius",
        "label": "Corner style",
        "options": [
          { "value": "sharp", "label": "Sharp" },
          { "value": "soft", "label": "Soft (default)" },
          { "value": "pill", "label": "Pill" }
        ],
        "default": "soft"
      }
    ]
  },
  {
    "name": "Product badges",
    "settings": [
      {
        "type": "checkbox",
        "id": "badge_show_sale",
        "label": "Show Sale badge",
        "default": true,
        "info": "Shown automatically when a compare-at price exists"
      },
      {
        "type": "checkbox",
        "id": "badge_show_new",
        "label": "Show New badge",
        "default": true
      },
      {
        "type": "range",
        "id": "badge_new_days",
        "min": 7,
        "max": 60,
        "step": 1,
        "unit": "days",
        "label": "Consider a product \"New\" for",
        "default": 21
      },
      {
        "type": "checkbox",
        "id": "badge_show_bestseller",
        "label": "Show Bestseller badge",
        "default": true,
        "info": "Shown on products tagged \"bestseller\" in the admin"
      },
      {
        "type": "checkbox",
        "id": "badge_show_low_stock",
        "label": "Show low-stock badge",
        "default": true,
        "info": "Only shown for products with inventory tracking enabled"
      },
      {
        "type": "range",
        "id": "badge_low_stock_threshold",
        "min": 1,
        "max": 20,
        "step": 1,
        "unit": "units",
        "label": "Low-stock threshold",
        "default": 5
      }
    ]
  },
  {
    "name": "Cart & shipping",
    "settings": [
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold (INR)",
        "default": 999
      },
      {
        "type": "number",
        "id": "below_threshold_shipping_fee",
        "label": "Shipping fee below threshold (INR)",
        "default": 49
      },
      {
        "type": "checkbox",
        "id": "cod_enabled",
        "label": "Cash on Delivery available",
        "default": true
      },
      {
        "type": "text",
        "id": "cod_conditions",
        "label": "COD conditions note",
        "default": "COD available on eligible orders. A small COD fee may apply at checkout."
      },
      {
        "type": "text",
        "id": "returns_window_days",
        "label": "Returns & exchange window (days)",
        "default": "7"
      },
      {
        "type": "text",
        "id": "default_delivery_estimate",
        "label": "Default delivery estimate",
        "default": "4-7 business days",
        "info": "Shown on the PDP delivery check until you configure zone-specific estimates"
      }
    ]
  },
  {
    "name": "Social & contact",
    "settings": [
      {
        "type": "text",
        "id": "contact_email",
        "label": "Support email",
        "default": "nexoira.supply@gmail.com"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Support phone",
        "info": "Optional"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram URL",
        "info": "Optional"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook URL",
        "info": "Optional"
      },
      {
        "type": "text",
        "id": "contact_whatsapp",
        "label": "WhatsApp number",
        "info": "Optional. Include country code, e.g. 919876543210. Used for a WhatsApp support link once configured."
      }
    ]
  },
  {
    "name": "Primary navigation",
    "settings": [
      {
        "type": "paragraph",
        "content": "The four primary nav items are fixed by design. These links are shared between the header and footer; the header's own settings add the optional mega-menu dropdown and promo tile for each."
      },
      {
        "type": "url",
        "id": "shirts_url",
        "label": "Shirts link",
        "default": "/collections/shirts"
      },
      {
        "type": "url",
        "id": "kurtas_url",
        "label": "Kurtas link",
        "default": "/collections/kurtas"
      },
      {
        "type": "url",
        "id": "pants_url",
        "label": "Pants link",
        "default": "/collections/pants"
      },
      {
        "type": "url",
        "id": "about_url",
        "label": "About link",
        "default": "/pages/about"
      }
    ]
  },
  {
    "name": "Key pages",
    "settings": [
      {
        "type": "paragraph",
        "content": "Used by the header, mobile menu and footer. Defaults match the page handles this theme expects you to create in Online Store → Pages; update any of these if you use different handles."
      },
      {
        "type": "url",
        "id": "size_guide_url",
        "label": "Size Guide",
        "default": "/pages/size-guide"
      },
      {
        "type": "url",
        "id": "faq_url",
        "label": "FAQ",
        "default": "/pages/faq"
      },
      {
        "type": "url",
        "id": "contact_url",
        "label": "Contact Us",
        "default": "/pages/contact"
      },
      {
        "type": "url",
        "id": "track_order_url",
        "label": "Track Order",
        "default": "/pages/track-order"
      }
    ]
  },
  {
    "name": "Occasions",
    "settings": [
      {
        "type": "paragraph",
        "content": "Optional collection links for occasion-based shopping (used in the mobile menu and homepage). Left blank until you create the matching collection."
      },
      {
        "type": "url",
        "id": "occasion_casual_url",
        "label": "Casual"
      },
      {
        "type": "url",
        "id": "occasion_smart_casual_url",
        "label": "Smart Casual"
      },
      {
        "type": "url",
        "id": "occasion_traditional_url",
        "label": "Traditional"
      }
    ]
  }
]
